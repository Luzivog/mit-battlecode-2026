# Copy to .env (git-ignored) at the repository root or to ~/battlecode26-data/.env, and fill in.
# Only the Imperial compute tools (tools/run, tools/compute, tools/games --remote) and autoscrims read these;
# local games and every other tool need none of them.
BC26_WORKSPACE=/vol/gpudata/USER-bc26
BC26_KERBEROS_PRINCIPAL=USER@IC.AC.UK
BC26_BW_ITEM=
# autoscrims/scrim_script.py: the Battlecode website account
BC_USERNAME=
BC_PASSWORD=

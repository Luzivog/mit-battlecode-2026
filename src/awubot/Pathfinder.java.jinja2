package awubot;

import battlecode.common.*;
import static awubot.util.Util.*;
import awubot.util.Profiler;
import static awubot.Game.*;

{% set MAX_BUG_ITERS = 5 %}

class BugnavInstance {
    MapLocation target;
    // false for the instances spawned when guessing
    boolean isMaster;
    // i guessed last turn, so i don't need to guess again
    boolean justGuessed = false;

    Direction bottomDir, topDir;

    // state (you can reconstruct the entire state from these variables + target/bottomDir)
    MapLocation pos;
    int stackSize;
    int emptyStackTurns;
    boolean leftTurn;

    public int pathLength;
    {% set MAX_PATH_BACKUP = 500 %}
    {% for i in range(MAX_PATH_BACKUP) %}
    public MapLocation path{{i}};
    int stackSize{{i}};
    int emptyStackTurns{{i}};
    boolean leftTurn{{i}};
    {% endfor %}

    // used to speed up the hot path of setCurrentState (which is a noop)
    static MapLocation lastLoc;
    void reset() {
        pos = rc.getLocation();
        pathLength = 0;
        stackSize = 0;
        emptyStackTurns = 1000;
        bottomDir = topDir = pos.directionTo(target);
        lastLoc = new MapLocation(-1, -1);
    }

    BugnavInstance(boolean leftTurn, MapLocation target) {
        this.leftTurn = leftTurn;
        this.target = target;
        this.isMaster = true;
        reset();
    }

    BugnavInstance(MapLocation pos, boolean leftTurn, MapLocation target, boolean isMaster) {
        indicate("RESET");
        this.leftTurn = leftTurn;
        this.target = target;
        this.isMaster = isMaster;
        reset();
        this.pos = pos;
        appendCurrentState();
    }

    {% for i in range(MAX_PATH_BACKUP) %}
    void setCurrentState{{i + 1}}() {
        pos = path{{i}};
        bottomDir = pos.directionTo(target);
        stackSize = stackSize{{i}};
        leftTurn = leftTurn{{i}};
        emptyStackTurns = emptyStackTurns{{i}};
        topDir = bottomDir;
        if(leftTurn) {
            for(int i = stackSize; i > 0; i--) {
                topDir = topDir.rotateLeft();
            }
        } else {
            for(int i = stackSize; i > 0; i--) {
                topDir = topDir.rotateRight();
            }
        }
        pathLength = {{i + 1}};
    }

    void appendCurrentState{{i}}() {
        path{{i}} = pos;
        stackSize{{i}} = stackSize;
        leftTurn{{i}} = leftTurn;
        emptyStackTurns{{i}} = emptyStackTurns;
        pathLength++;
    }
    {% endfor %}

    void setCurrentState() {
        switch(pathLength) {
            {% for length in range(MAX_PATH_BACKUP, 0, -1) %}
            case {{length}}:
                if(chebyshevDistance(path{{length - 1}}, rc.getLocation()) <= 5) {
                    if(pathLength != {{length}}) setCurrentState{{length}}();
                    break;
                }
                {% endfor %}
            default:
                assert(pathLength <= {{MAX_PATH_BACKUP}});
                reset();
        }
    }

    void appendCurrentState() {
        switch (pathLength) {
            {% for length in range(MAX_PATH_BACKUP - 1, -1, -1) %}
            case {{length}} -> {
                {% if length != 0 %}
                if (!path{{length - 1}}.equals(pos))
                    {% endif %}
                {
                    appendCurrentState{{length}}();
                }
            }
            {% endfor %}
            default -> { assert(pathLength < {{MAX_PATH_BACKUP}}); }
        }
    }

    // return the original location
    MapLocation advance(boolean canGuess) throws GameActionException {
        // System.out.println("old pos " + pos + " i am at " + rc.getLocation());
        if(!rc.getLocation().equals(lastLoc)) {
            lastLoc = rc.getLocation();
            setCurrentState();
        }

        if(pos.isAdjacentTo(target)) return pos;

        var dirToTarget = pos.directionTo(target);
        if(dirToTarget != bottomDir) {
            if(dirToTarget == Direction.CENTER) return pos;
            {% macro updateBottomDir(turnDir, reverseDir) %}
            if(dirToTarget == bottomDir.rotate{{reverseDir}}()) {
                bottomDir = dirToTarget;
                stackSize++;
            } else {
                assert dirToTarget == bottomDir.rotate{{turnDir}}() : "unexpected direction change from " + bottomDir + " to " + dirToTarget;
                bottomDir = dirToTarget;
                stackSize--;
                if(stackSize < 0) {
                    stackSize = 0;
                    topDir = bottomDir;
                }
            }
            {% endmacro %}
            if(leftTurn) {
                {{ updateBottomDir("Left", "Right") }}
            } else {
                {{ updateBottomDir("Right", "Left") }}
            }
        }

        var oldPos = pos;

        MapLocation greedyLoc = pos.add(bottomDir);
        if(stackSize <= 1) {
            {% macro go(loc) %}
            if(chebyshevDistance(rc.getLocation(), {{loc}}) <= 5) {
                indicate("going to {{loc}}");
                pos = {{loc}};
                topDir = bottomDir;
                stackSize = 0;
                emptyStackTurns++;
                appendCurrentState();
            }
            return oldPos;
            {% endmacro %}
            if(CellTracker.isPassable(greedyLoc)) {
                {{ go("greedyLoc") }}
            }
            var leftLoc = pos.add(bottomDir.rotateLeft());
            var rightLoc = pos.add(bottomDir.rotateRight());
            var leftPassable = CellTracker.isPassable(leftLoc);
            var rightPassable = CellTracker.isPassable(rightLoc);
            if(leftPassable && !rightPassable) {
                {{ go("leftLoc") }}
            }
            if(!leftPassable && rightPassable) {
                {{ go("rightLoc") }}
            }
            if(leftPassable && rightPassable) {
                if(leftLoc.distanceSquaredTo(target) < rightLoc.distanceSquaredTo(target)) {
                    {{ go("leftLoc") }}
                } else {
                    {{ go("rightLoc") }}
                }
            }
        }
        // System.out.println("bug" + pos + " " + bottomDir + " " + topDir + " " + stackSize);

        // System.out.println(pos + " " + target + " " + topDir + " " + bottomDir + " " + stackSize);

        // rc.setIndicatorString("" + bottomDir + " " + topDir + " " + stackSize + " " + leftTurn + " " + emptyStackTurns);

        // guess rotation direction (kinda inefficient but wtv)
        if(isMaster && !justGuessed && stackSize == 0 && CellTracker.isSeen(greedyLoc)) {
            assert !CellTracker.isPassable(greedyLoc);
            if(emptyStackTurns >= 1) {
                if(canGuess) {
                    indicate("guessing " + pos);
                    Profiler.begin();
                    // System.out.println("guessing " + pos + " " + emptyStackTurns);
                    var leftBug = new BugnavInstance(pos, true, target, false);
                    var rightBug = new BugnavInstance(pos, false, target, false);
                    {% macro runBug(bug) %}
                    {
                        MapLocation bugPos;
                        int shade = 255;
                        bugLoop: {
                            {% for _ in range(MAX_BUG_ITERS) %}
                            bugPos = {{bug}}.advance(false);
                            // System.out.println(bugPos);
                            rc.setIndicatorDot(bugPos, Math.max(0, shade -= 30), 0, Math.max(0, shade));
                            if(bugPos.equals({{bug}}.pos)) break bugLoop;
                            {% endfor %}
                        }
                    }
                    {% endmacro %}
                    {{ runBug("leftBug") }}
                    {{ runBug("rightBug") }}
                    {% macro score(bug) %} Math.sqrt({{bug}}.pos.distanceSquaredTo(target)) + {{bug}}.pathLength * 0.7 {% endmacro %}
                    // indicate("lookahead");
                    // indicate(leftBug.pos);
                    // indicate({{ score("leftBug") }});
                    // indicate(rightBug.pos);
                    // indicate({{ score("rightBug") }});
                    leftTurn = {{ score("leftBug") }} < {{ score("rightBug") }};
                    // indicate("leftTurn " + leftTurn);
                    setCurrentState();
                    Profiler.end("guess");
                    justGuessed = true;
                }
                return pos;
            } else if(emptyStackTurns < 0) {
                emptyStackTurns = 0;
            }
        }
        justGuessed = false;

        // Profiler.begin();
        {% macro tryDirs(turnDir, reverseDir) %}
        // this loop only exists to allow continue
        while(true) {
            var tryDir = topDir.rotate{{reverseDir}}().rotate{{reverseDir}}();
            {% for turns in range(-2, 6) %}
            {% if turns < 0 %}
            if(stackSize + {{turns}} >= 0)
            {% endif %}
            {
                var nextPos = pos.add(tryDir);
                if(!CellTracker.isSeen(nextPos) || chebyshevDistance(rc.getLocation(), nextPos) > 5) {
                    if(rc.onTheMap(nextPos)) rc.setIndicatorDot(nextPos, 0, 255, 255);
                    else if(isMaster) {
                        // avoid following the edge of the map
                        indicate("bugnav hit edge of map");
                        leftTurn = !leftTurn;
                        reset();
                        // don't guess turn direction, we know that one direction is bad already
                        emptyStackTurns = -1000;
                        // start again
                        continue;
                    }
                    // Profiler.end("bugnav");
                    return oldPos;
                }
                if(CellTracker.isPassable(nextPos)) {
                    pos = nextPos;
                    topDir = tryDir;
                    {% if turns %}
                    stackSize += {{turns}};
                    {% endif %}
                    if(stackSize == 0) {
                        emptyStackTurns++;
                    } else {
                        emptyStackTurns = 0;
                    }
                    appendCurrentState();
                    // Profiler.end("bugnav");
                    return oldPos;
                }
            }
            tryDir = tryDir.rotate{{turnDir}}();
            {% endfor %}
            assert false : "no valid move found from " + pos;
        }
        {% endmacro %}

        if(leftTurn) {
            {{ tryDirs("Left", "Right") }}
        } else {
            {{ tryDirs("Right", "Left") }}
        }
    }
}

public class Pathfinder {
    static BugnavInstance bug;

    public static void makeMove(Direction dir) throws GameActionException {
        rc.turn(dir);
        rc.moveForward();
        // TODO: optimise
        CellTracker.computeLocalPassable();
    }

    public static void makeMove(MapLocation target) throws GameActionException {
        assert rc.isMovementReady();
        // TODO: optimise
        CellTracker.computeLocalPassable();
        // TODO: better handling when target changes
        if(bug == null || !target.equals(bug.target)) {
            indicate("RETARGET");
            bug = new BugnavInstance(true, target);
        }
        MapLocation bugPos;
        int shade = 255;
        bugLoop: {
            {% for i in range(MAX_BUG_ITERS) %}
            bugPos = bug.advance({% if i %} false {% else %} true {% endif %});
            indicate(bugPos);
            rc.setIndicatorDot(bugPos, 0, Math.max(0, shade -= 30), 0);
            if(bugPos.equals(bug.pos)) break bugLoop;
            {% endfor %}
        }
        rc.setIndicatorDot(bug.pos, 255, 0, 0);

        // no bfs needed
        var dir = rc.getLocation().directionTo(bugPos);
        // indicate(dir);
        if(rc.getLocation().add(dir).equals(bugPos)) {
            indicate("adjacent");
            makeMove(dir);
            return;
        }
        // TODO: what if location == bug.pos?

        // bfs
        var loc = rc.getLocation();
        // d{i}0 + d{i}1 is the mask of reachable within i steps
        long d00 = 0, d01 = 0;
        int idx = (bugPos.y - loc.y + 5) * 11 + (bugPos.x - loc.x + 5);
        if(idx < 61) {
            d00 |= 1l << idx;
        } else {
            d01 |= 1l << (idx - 61);
        }
        {% set BFS_MAX = 15 %}
        Direction bestMove = null;
        double bestScore = 1e18;
        {% for i in range(1, BFS_MAX) %}
        long d{{i}}0 = 0, d{{i}}1 = 0;
        d{{i}}0 = d{{i - 1}}0;
        d{{i}}1 = d{{i - 1}}1;

        // if(rc.getRoundNum() >= 303) {
        //     indicatorString = "";
        //     CellTracker.printLocalMask(CellTracker.localPassable0, CellTracker.localPassable1);
        //     Clock.yield();
        //     indicatorString = "";
        //     CellTracker.printLocalMask(d{{i}}0, d{{i}}1);
        //     Clock.yield();
        // }

        // we don't need to worry about the "seam" here because it's at the cell we are standing on
        d{{i}}0 |= (d{{i}}0 & 0xfbff7feffdffbffl) << 1;
        d{{i}}1 |= (d{{i}}1 & 0x7feffdffbff7fefl) << 1;
        d{{i}}0 |= (d{{i}}0 & 0x1f7feffdffbff7fel) >> 1;
        d{{i}}1 |= (d{{i}}1 & 0xffdffbff7feffdel) >> 1;

        d{{i}}1 |= ((d{{i}}1 & 0x1ffffffffffffl) << 11) | (d{{i}}0 >> 50);
        d{{i}}0 |= (d{{i}}0 & 0x3ffffffffffffl) << 11;
        d{{i}}0 |= (d{{i}}0 >> 11) | ((d{{i}}1 & 0x7ffl) << 50);
        d{{i}}1 |= d{{i}}1 >> 11;
        d{{i}}0 &= CellTracker.localPassable0;
        d{{i}}1 &= CellTracker.localPassable1;
        if((d{{i}}0 & 0x807000000000000l) != 0 || (d{{i}}1 & 0xe01) != 0) {
            {% for dir, off in [
                                ("Direction.SOUTH", 49),
                                ("Direction.EAST", 61),
                                ("Direction.NORTH", 71),
                                ("Direction.WEST", 59),
                                ("Direction.SOUTHWEST", 48),
                                ("Direction.SOUTHEAST", 50),
                                ("Direction.NORTHWEST", 70),
                                ("Direction.NORTHEAST", 72),
                                ] %}
            if(
               {% if off < 61 %}
               (d{{i}}0 & (1l << {{off}}))
               {% else %}
               (d{{i}}1 & (1l << {{off - 61}}))
               {% endif %}
               != 0) {
                var nextLoc = loc.add({{dir}});
                double score = nextLoc.distanceSquaredTo(target) + nextLoc.distanceSquaredTo(bugPos);
                if(score < bestScore) {
                    bestMove = {{dir}};
                    bestScore = score;
                }
            }
            {% endfor %}
            if(bestMove != null) {
                makeMove(bestMove);
                // System.out.println("iterations: " + {{i}});
                return;
            }
        }
        {% endfor %}
        assert false : "TODO: fallback when bfs can't find path";
    }
}

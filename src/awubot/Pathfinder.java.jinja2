package awubot;

import battlecode.common.*;
import static awubot.util.Util.*;
import awubot.util.Rng;
import awubot.util.Profiler;
import static awubot.Game.*;

{% set MAX_BUG_ITERS = 5 %}
{% set MAX_PATH = 25 %}

class BugnavInstance {
    MapLocation target;
    // false for the instances spawned when guessing
    boolean isMaster;
    // i guessed last turn, so i don't need to guess again
    // set to false when i move successfully
    boolean justGuessed;
    // loop detection
    long[] guessedLeft, guessedRight;

    // extra "return variables" for lookahead instances
    boolean hitEdge = false, outOfSight = false;

    Direction bottomDir, topDir;

    // state (you can reconstruct the entire state from these variables + target/bottomDir)
    MapLocation pos;
    int stackSize;
    int emptyStackTurns;
    boolean leftTurn;

    public int nextPathIndex;
    {% for i in range(MAX_PATH) %}
    public MapLocation path{{i}};
    {% endfor %}

    void clearPath() {
        pos = rc.getLocation();
        justGuessed = false;
        nextPathIndex = 0;
        stackSize = 0;
        emptyStackTurns = 1000;
        bottomDir = topDir = pos.directionTo(target);
        {% for i in range(MAX_PATH) %}
        path{{i}} = new MapLocation(-1000, -1000);
        {% endfor %}
    }

    BugnavInstance(boolean leftTurn, MapLocation target) {
        this.leftTurn = leftTurn;
        this.target = target;
        this.isMaster = true;
        guessedLeft = new long[mapHeight];
        guessedRight = new long[mapHeight];
        clearPath();
    }

    BugnavInstance(MapLocation pos, boolean leftTurn, MapLocation target, boolean isMaster) {
        indicate("RESET");
        this.leftTurn = leftTurn;
        this.target = target;
        this.isMaster = isMaster;
        clearPath();
        this.pos = pos;
        appendCurrentPosition();
    }

    void appendCurrentPosition() {
        switch (nextPathIndex) {
            {% for i in range(MAX_PATH) %}
            case {{i}} -> {
                if (!path{{(i - 1 + MAX_PATH) % MAX_PATH}}.equals(pos)) {
                    path{{i}} = pos;
                    nextPathIndex = {{(i + 1) % MAX_PATH}};
                }
            }
            {% endfor %}
            default -> {
                assert false;
            }
        }
    }

    MapLocation getRecentPos(int i) {
        switch ((nextPathIndex - i + {{MAX_PATH - 1}}) % {{MAX_PATH}}) {
            {% for i in range(MAX_PATH) %}
            case {{i}} -> {
                return path{{i}};
            }
            {% endfor %}
            default -> {
                assert false : "index out of range";
                return null;
            }
        }
    }

    // false = halt bug
    boolean advance(boolean canLookahead) throws GameActionException {
        // System.out.println("old pos " + pos + " i am at " + rc.getLocation());

        if(pos.isAdjacentTo(target)) return false;

        var dirToTarget = pos.directionTo(target);
        if(dirToTarget != bottomDir) {
            // indicate("changing bottomDir from " + bottomDir + " to " + dirToTarget);
            if(dirToTarget == Direction.CENTER) return false;
            if(stackSize == 0) {
                bottomDir = topDir = dirToTarget;
            } else {
                {% macro updateBottomDir(turnDir, reverseDir) %}
                if(dirToTarget == bottomDir.rotate{{reverseDir}}()) {
                    bottomDir = dirToTarget;
                    stackSize++;
                } else {
                    assert dirToTarget == bottomDir.rotate{{turnDir}}() : "unexpected direction change from " + bottomDir + " to " + dirToTarget;
                    bottomDir = dirToTarget;
                    stackSize--;
                    if(stackSize < 0) {
                        stackSize = 0;
                        topDir = bottomDir;
                    }
                }
                {% endmacro %}
                if(leftTurn) {
                    {{ updateBottomDir("Left", "Right") }}
                } else {
                    {{ updateBottomDir("Right", "Left") }}
                }
            }
        }
        // indicate("direction " + pos + " " + topDir + " " + bottomDir + " " + leftTurn);

        MapLocation greedyLoc = pos.add(bottomDir);
        if(stackSize <= 1) {
            {% macro go(where) %}
            if({{where}}Passable && chebyshevDistance(rc.getLocation(), {{where}}Loc) <= 5) {
                indicate("{{where}}Loc");
                pos = {{where}}Loc;
                justGuessed = false;
                topDir = bottomDir;
                stackSize = 0;
                emptyStackTurns++;
                appendCurrentPosition();
                return true;
            }
            return false;
            {% endmacro %}
            // indicate("target " + target + " " + bottomDir + " " + pos + " " + pos.add(bottomDir.rotateRight()));
            var greedyPassable = CellTracker.isPassable(greedyLoc);
            var greedyGood = greedyPassable || !CellTracker.isSeen(greedyLoc);
            if(greedyGood) {
                {{ go("greedy") }}
            }
            var leftLoc = pos.add(bottomDir.rotateLeft());
            var rightLoc = pos.add(bottomDir.rotateRight());
            var leftPassable = CellTracker.isPassable(leftLoc);
            var leftGood = (leftPassable || !CellTracker.isSeen(leftLoc)) && rc.onTheMap(leftLoc);
            var rightPassable = CellTracker.isPassable(rightLoc);
            var rightGood = (rightPassable || !CellTracker.isSeen(rightLoc)) && rc.onTheMap(rightLoc);
            if(leftGood && !rightGood) {
                {{ go("left") }}
            }
            if(!leftGood && rightGood) {
                {{ go("right") }}
            }
            if(leftGood && rightGood) {
                if(leftLoc.distanceSquaredTo(target) < rightLoc.distanceSquaredTo(target)) {
                    {{ go("left") }}
                } else {
                    {{ go("right") }}
                }
            }
        }
        // System.out.println("bug" + pos + " " + bottomDir + " " + topDir + " " + stackSize);

        // System.out.println(pos + " " + target + " " + topDir + " " + bottomDir + " " + stackSize);

        // rc.setIndicatorString("" + bottomDir + " " + topDir + " " + stackSize + " " + leftTurn + " " + emptyStackTurns);

        // indicate("GC " + justGuessed + " " + stackSize + " " + CellTracker.isSeen(greedyLoc) + " " + emptyStackTurns + " " + canLookahead);
        // guess rotation direction (kinda inefficient but wtv)
        if(isMaster && !justGuessed && stackSize == 0 && CellTracker.isSeen(greedyLoc)) {
            assert !CellTracker.isPassable(greedyLoc);
            if(emptyStackTurns >= 3) {
                boolean pastLeft = ((guessedLeft[pos.y] >> pos.x) & 1l) != 0;
                boolean pastRight = ((guessedRight[pos.y] >> pos.x) & 1l) != 0;
                if(pastLeft && pastRight) {
                    indicate("guessing");
                    // just pick randomly, we have no idea what's going on
                    leftTurn = Rng.mcg() >> 30 == 0;
                } else if(pastLeft) {
                    indicate("past left");
                    // try the other way
                    leftTurn = false;
                } else if(pastRight) {
                    indicate("past right");
                    leftTurn = true;
                } else {
                    if(canLookahead) {
                        // Profiler.begin();
                        // System.out.println("guessing " + pos + " " + emptyStackTurns);
                        var leftBug = new BugnavInstance(pos, true, target, false);
                        var rightBug = new BugnavInstance(pos, false, target, false);
                        {% macro runBug(bug) %}
                        {
                            int shade = 255;
                            bugLoop: {
                                {% for _ in range(MAX_BUG_ITERS) %}
                                rc.setIndicatorDot({{bug}}.pos, Math.max(0, shade -= 30), 0, Math.max(0, shade));
                                if(!{{bug}}.advance(false)) break bugLoop;
                                {% endfor %}
                            }
                        }
                        {% endmacro %}
                        {{ runBug("leftBug") }}
                        {{ runBug("rightBug") }}
                        {% macro score(bug) %} Math.sqrt({{bug}}.pos.distanceSquaredTo(target)) + {{bug}}.nextPathIndex * 0.7 {% endmacro %}
                        var leftScore = {{ score("leftBug") }};
                        var rightScore = {{ score("rightBug") }};
                        indicate("lookahead" + pos);
                        // indicate(leftBug.pos);
                        indicate(leftScore);
                        // indicate(rightBug.pos);
                        indicate(rightScore);

                        {% macro setLeftTurn(val) %}
                        leftTurn = {{val}};
                        if(leftTurn) {
                            guessedLeft[pos.y] |= 1l << pos.x;
                        } else {
                            guessedRight[pos.y] |= 1l << pos.x;
                        }
                        indicate("just guessed " + leftTurn);
                        justGuessed = true;
                        {% endmacro %}

                        if(leftBug.hitEdge != rightBug.hitEdge) {
                            {{ setLeftTurn("rightBug.hitEdge") }}
                        } else {
                            var better = leftScore < rightScore ? leftBug : rightBug;
                            var worse = leftScore < rightScore ? rightBug : leftBug;
                            if(!better.outOfSight && worse.outOfSight) {
                                indicate("clear winner");
                                {{ setLeftTurn("leftScore < rightScore") }}
                            } else if(!better.outOfSight || rc.getLocation().isAdjacentTo(pos)) {
                                leftScore = Math.pow(leftScore, 15);
                                rightScore = Math.pow(rightScore, 15);
                                var total = leftScore + rightScore;
                                leftScore /= total;
                                rightScore /= total;
                                // {{ setLeftTurn("leftScore < rightScore") }}
                                {{ setLeftTurn("Rng.mcg() < rightScore * 0x7fffffff") }}
                            }
                        }
                        // indicate("leftTurn " + leftTurn);
                        // Profiler.end("guess");
                    }
                    return false;
                }
            } else if(emptyStackTurns < 0) {
                emptyStackTurns = 0;
            }
        }

        // Profiler.begin();
        {% macro tryDirs(turnDir, reverseDir) %}
        // this loop only exists to allow continue
        while(true) {
            var tryDir = topDir.rotate{{reverseDir}}().rotate{{reverseDir}}();
            {% for turns in range(-2, 6) %}
            {% if turns < 0 %}
            if(stackSize + {{turns}} >= 0)
            {% endif %}
            {
                // indicate("trying " + tryDir);
                var nextPos = pos.add(tryDir);
                if(!CellTracker.isSeen(nextPos) || chebyshevDistance(rc.getLocation(), nextPos) > 5) {
                    if(rc.onTheMap(nextPos)) {
                        rc.setIndicatorDot(nextPos, 0, 255, 255);
                        outOfSight = true;
                    } else if(isMaster) {
                        // avoid following the edge of the map (TODO: 1-thick borders)
                        indicate("bugnav hit edge of map");
                        leftTurn = !leftTurn;
                        clearPath();
                        // don't guess turn direction, we know that one direction is bad already
                        emptyStackTurns = -1000;
                        // start again
                        continue;
                    } else {
                        hitEdge = true;
                    }
                    // Profiler.end("bugnav");
                    return false;
                }
                if(CellTracker.isPassable(nextPos)) {
                    pos = nextPos;
                    justGuessed = false;
                    topDir = tryDir;
                    {% if turns %}
                    stackSize += {{turns}};
                    {% endif %}
                    if(stackSize == 0) {
                        emptyStackTurns++;
                    } else {
                        emptyStackTurns = 0;
                    }
                    appendCurrentPosition();
                    // Profiler.end("bugnav");
                    return true;
                }
            }
            tryDir = tryDir.rotate{{turnDir}}();
            {% endfor %}
            assert false : "no valid move found from " + pos;
        }
        {% endmacro %}

        if(leftTurn) {
            {{ tryDirs("Left", "Right") }}
        } else {
            {{ tryDirs("Right", "Left") }}
        }
    }
}

public class Pathfinder {
    static BugnavInstance bug;

    public static void turn(Direction dir) throws GameActionException {
        rc.turn(dir);
        CellTracker.storeVisibleCells();
    }

    public static void moveForward() throws GameActionException {
        rc.moveForward();
        CellTracker.storeVisibleCellsPostMove();
    }

    public static void makeMove(Direction dir) throws GameActionException {
        if(dir != rc.getDirection()) turn(dir);
        moveForward();
    }

    public static void makeMove(MapLocation target) throws GameActionException {
        assert rc.isMovementReady();
        // TODO: better handling when target changes
        if(bug == null || !target.equals(bug.target)) {
            indicate("RETARGET");
            bug = new BugnavInstance(true, target);
        }
        int shade = 255;
        Profiler.begin();
        bugLoop: {
            {% for i in range(MAX_BUG_ITERS) %}
            rc.setIndicatorDot(bug.pos, 0, Math.max(0, shade -= 30), 0);
            if(!bug.advance({% if i %} false {% else %} true {% endif %})) break bugLoop;
            {% endfor %}
        }
        Profiler.end("bug");
        rc.setIndicatorDot(bug.pos, 255, 0, 0);

        // no bfs needed
        var dir = rc.getLocation().directionTo(bug.pos);
        // indicate(dir);
        if(rc.getLocation().add(dir).equals(bug.pos)) {
            indicate("adjacent");
            makeMove(dir);
            return;
        }
        // TODO: what if location == bug.pos?

        Profiler.begin();
        CellTracker.computeLocalPassable();
        Profiler.end("computeLocalPassable");

        Profiler.begin();
        // bfs
        var loc = rc.getLocation();
        // d{i}0 + d{i}1 is the mask of reachable within i steps
        long d00 = 0, d01 = 0;
        {% macro writePos(pos, i) %}
        {
            int xi = {{pos}}.x - loc.x + 5;
            int yi = {{pos}}.y - loc.y + 5;
            if(xi >= 0 && xi < 11 && yi >= 0 && yi < 11) {
                int idx = yi * 11 + xi;
                if(idx < 61) {
                    d{{i}}0 |= 1l << idx;
                } else {
                    d{{i}}1 |= 1l << (idx - 61);
                }
            }
        }
        {% endmacro %}
        {{ writePos("bug.pos", 0) }}
        Direction bestMove = null;
        double bestScore = 1e18;
        {% for i in range(1, MAX_PATH) %}
        long d{{i}}0 = 0, d{{i}}1 = 0;
        d{{i}}0 = d{{i - 1}}0;
        d{{i}}1 = d{{i - 1}}1;

        // if(rc.getRoundNum() >= 507) {
        //     indicatorString = "";
        //     CellTracker.printLocalMask(d{{i}}0, d{{i}}1);
        //     Clock.yield();
        // }

        // we don't need to worry about the "seam" here because it's at the cell we are standing on
        d{{i}}0 |= (d{{i}}0 & 0xfbff7feffdffbffl) << 1;
        d{{i}}1 |= (d{{i}}1 & 0x7feffdffbff7fefl) << 1;
        d{{i}}0 |= (d{{i}}0 & 0x1f7feffdffbff7fel) >> 1;
        d{{i}}1 |= (d{{i}}1 & 0xffdffbff7feffdel) >> 1;

        d{{i}}1 |= ((d{{i}}1 & 0x1ffffffffffffl) << 11) | (d{{i}}0 >> 50);
        d{{i}}0 |= (d{{i}}0 & 0x3ffffffffffffl) << 11;
        d{{i}}0 |= (d{{i}}0 >> 11) | ((d{{i}}1 & 0x7ffl) << 50);
        d{{i}}1 |= d{{i}}1 >> 11;
        {{ writePos("bug.getRecentPos(%s)" % i, i) }}
        d{{i}}0 &= CellTracker.localPassable0;
        d{{i}}1 &= CellTracker.localPassable1;
        if((d{{i}}0 & 0x807000000000000l) != 0 || (d{{i}}1 & 0xe01) != 0) {
            // this is sloppy since we only care about tiles <= 2 chebyshev distance away
            long notWallAdjacent0 = CellTracker.localPassable0, notWallAdjacent1 = CellTracker.localPassable1;
            notWallAdjacent1 &= (notWallAdjacent1 << 1) | (notWallAdjacent0 >> 60);
            notWallAdjacent0 &= notWallAdjacent0 << 1;
            notWallAdjacent0 &= (notWallAdjacent0 >> 1) | ((notWallAdjacent1 & 1l) << 60);
            notWallAdjacent1 &= notWallAdjacent1 >> 1;
            notWallAdjacent1 &= (notWallAdjacent1 << 11) | (notWallAdjacent0 >> 50);
            notWallAdjacent0 &= notWallAdjacent0 << 11;
            notWallAdjacent0 &= (notWallAdjacent0 >> 11) | ((notWallAdjacent1 & 0x7ffl) << 50);
            notWallAdjacent1 &= notWallAdjacent1 >> 11;

            {% for dir, off in [
                                ("Direction.SOUTH", 49),
                                ("Direction.EAST", 61),
                                ("Direction.NORTH", 71),
                                ("Direction.WEST", 59),
                                ("Direction.SOUTHWEST", 48),
                                ("Direction.SOUTHEAST", 50),
                                ("Direction.NORTHWEST", 70),
                                ("Direction.NORTHEAST", 72),
                                ] %}
            if(
               {% if off < 61 %}
               (d{{i}}0 & (1l << {{off}}))
               {% else %}
               (d{{i}}1 & (1l << {{off - 61}}))
               {% endif %}
               != 0) {
                var nextLoc = loc.add({{dir}});
                double score = nextLoc.distanceSquaredTo(target) + nextLoc.distanceSquaredTo(bug.pos);
                if(
                   {% if off < 61 %}
                   (notWallAdjacent0 & (1l << {{off}}))
                   {% else %}
                   (notWallAdjacent1 & (1l << {{off - 61}}))
                   {% endif %}
                   != 0
                   ) {
                    score /= 2;
                }
                if(score < bestScore) {
                    bestMove = {{dir}};
                    bestScore = score;
                }
            }
            {% endfor %}
            if(bestMove != null) {
                Profiler.end("bfs");
                makeMove(bestMove);
                // System.out.println("iterations: " + {{i}});
                return;
            }
        }
        {% endfor %}
        indicatorString = "";
        CellTracker.printLocalMask(CellTracker.localPassable0, CellTracker.localPassable1);
        assert false : "TODO: fallback when bfs can't find path";
    }
}

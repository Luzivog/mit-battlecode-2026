{% macro java_char_literal(code) -%}
{%- if code == 10 -%}'\n'
{%- elif code == 13 -%}'\r'
{%- elif code == 9 -%}'\t'
{%- elif code == 8 -%}'\b'
{%- elif code == 12 -%}'\f'
{%- else -%}'\u{{ "%04X"|format(code) }}'
{%- endif -%}
{%- endmacro %}

{% macro java_string_char(code) -%}
{%- if code == 10 -%}\n
{%- elif code == 13 -%}\r
{%- elif code == 9 -%}\t
{%- elif code == 8 -%}\b
{%- elif code == 12 -%}\f
{%- else -%}\u{{ "%04X"|format(code) }}
{%- endif -%}
{%- endmacro %}

{% macro get_team_ordinal(team) -%}
{%- if team == 'A' -%}0
{%- elif team == 'B' -%}1
{%- else -%}2
{%- endif -%}
{%- endmacro %}

package awubot;

import awubot.util.string.FastMapLocationSet;
import battlecode.common.*;
import static awubot.Game.*;
import static awubot.util.Util.*;
import awubot.util.Profiler;

{%- set OFF = 0x0FFF -%}
{%- set MAX_DIST = 34 -%}

public class RobotTracker {
    
    private static StringBuilder baseString = new StringBuilder("{% for c in range(0, MAX_DIST) %}{{ java_string_char(OFF + c) }}{% endfor %}");
    public static RobotInfo[] sortedRobots = new RobotInfo[25];
    public static RobotInfo[] sortedEnemies = new RobotInfo[25];
    public static RobotInfo[] sortedAllies = new RobotInfo[25];
    public static RobotInfo[] sortedCats = new RobotInfo[5];
    public static int numRobots, numEnemies, numAllies, numCats;
    private static char DELIM_CHAR = '\u0FFF';
    private static String DELIM_STRING = "\u0FFF";

    public static void init() {
    }

    public static void preTick() {
        println("preTick");
        updateRobots();
    }

    public static void updateRobots() {
        if (team == Team.A) {
            updateRobotsA();
        } else {
            updateRobotsB();
        }
    }

    {% for myTeam in ['A', 'B'] %}
    {% set enemy = 'B' if myTeam == 'A' else 'A' %}
    public static void updateRobots{{myTeam}}() {
        // Profiler.begin();
        StringBuilder sb = new StringBuilder(baseString);
        RobotInfo[] nearbyRobots = rc.senseNearbyRobots();
        numRobots = nearbyRobots.length;
        numEnemies = numAllies = numCats = 0;
        switch (numRobots) {
            {% for count in range(MAX_DIST - 1, -1, -1) %}
            case {{count + 1}}: {
                int d = nearbyRobots[{{count}}].location.distanceSquaredTo(myLoc);
                {# assert(d <= {{MAX_DIST}}) : "Robot at distance " + d + " > MAX_DIST {{MAX_DIST}}" + " location " + nearbyRobots[{{count}}].location + " my loc " + myLoc; #}
                int j = sb.indexOf(String.valueOf((char) ({{OFF}} + d)));
                sb.insert(j, {{ java_char_literal(count) }});
                switch (nearbyRobots[{{count}}].team.ordinal()) {
                    case {{get_team_ordinal('NEUTRAL')}}:
                        numCats++;
                        break;
                    case {{get_team_ordinal(myTeam)}}:
                        numAllies++;
                        break;
                    case {{get_team_ordinal(enemy)}}:
                        numEnemies++;
                        break;
                }
            }
            {% endfor %}
            case 0:
                break;
            default:
                assert(false);
                break;
        }
        int i;
        {% for i in range(0, MAX_DIST) %}
        sb.deleteCharAt(sb.indexOf("{{ java_string_char(OFF + i) }}"));
        {% endfor %}

        int nextAlly = numAllies;
        int nextEnemy = numEnemies;
        int nextCat = numCats;
        switch (numRobots) {
            {% for count in range(MAX_DIST - 1, -1, -1) %}
            case {{count + 1}}: { 
                sortedRobots[{{count}}] =  nearbyRobots[(int) sb.charAt({{count}})];
                switch (sortedRobots[{{count}}].team.ordinal()) {
                    case {{get_team_ordinal('NEUTRAL')}}:
                        sortedCats[--nextCat] = sortedRobots[{{count}}];
                        break;
                    case {{get_team_ordinal(myTeam)}}:
                        sortedAllies[--nextAlly] = sortedRobots[{{count}}];
                        break;
                    case {{get_team_ordinal(enemy)}}:
                        sortedEnemies[--nextEnemy] = sortedRobots[{{count}}];
                        break;
                }
            }
            {% endfor %}
            case 0:
                break;
            default:
                assert(false);
                break;
        }
        // Profiler.end_print("updateRobots");
    }
    {% endfor %}

    public static int allyCount = 0;
    public static MapLocation[] allies = new MapLocation[55];
    public static FastMapLocationSet allySet, kingSet;
    private static MapLocation[][] pastKingLocs = new MapLocation[5][5];
    private static int[] pastKingCounts = new int[5];
    public static void addAlly(MapLocation loc) {
        if(!allySet.contains(loc)) {
            allies[allyCount++] = loc;
            allySet.add(loc);
        }
    }
 
    // IF TLE: optimise this
    public static void reset() throws GameActionException {
        allyCount = 0;
        allySet = new FastMapLocationSet();
        pastKingCounts[time % 5] = 0;
        for(var robot : rc.senseNearbyRobots(-1, team)) {
            var loc = robot.location;
            if(robot.type == UnitType.BABY_RAT) {
                addAlly(loc);
            } else {
                pastKingLocs[time % 5][pastKingCounts[time % 5]++] = loc;
            }
        }
    }
    public static void writeHistoricalKingLocs() {
        // hack to remember where kings are
        kingSet = new FastMapLocationSet();
        {% for i in range(0, 5) %}
        {
            int count = pastKingCounts[{{i}}];
            switch (count) {
                case 5: {
                    int j = 4;
                    var loc = pastKingLocs[{{i}}][j];
                    var locX = loc.x;
                    var locY = loc.y;
                    {% for dx in range(-1, 2) %}
                    {% for dy in range(-1, 2) %}
                    {
                        var kloc = new MapLocation(locX + {{dx}}, locY + {{dy}});
                        addAlly(kloc);
                        kingSet.add(kloc);
                    }
                    {% endfor %}
                    {% endfor %}
                }
                case 4: {
                    int j = 3;
                    var loc = pastKingLocs[{{i}}][j];
                    var locX = loc.x;
                    var locY = loc.y;
                    {% for dx in range(-1, 2) %}
                    {% for dy in range(-1, 2) %}
                    {
                        var kloc = new MapLocation(locX + {{dx}}, locY + {{dy}});
                        addAlly(kloc);
                        kingSet.add(kloc);
                    }
                    {% endfor %}
                    {% endfor %}
                }
                case 3: {
                    int j = 2;
                    var loc = pastKingLocs[{{i}}][j];
                    var locX = loc.x;
                    var locY = loc.y;
                    {% for dx in range(-1, 2) %}
                    {% for dy in range(-1, 2) %}
                    {
                        var kloc = new MapLocation(locX + {{dx}}, locY + {{dy}});
                        addAlly(kloc);
                        kingSet.add(kloc);
                    }
                    {% endfor %}
                    {% endfor %}
                }
                case 2: {
                    int j = 1;
                    var loc = pastKingLocs[{{i}}][j];
                    var locX = loc.x;
                    var locY = loc.y;
                    {% for dx in range(-1, 2) %}
                    {% for dy in range(-1, 2) %}
                    {
                        var kloc = new MapLocation(locX + {{dx}}, locY + {{dy}});
                        addAlly(kloc);
                        kingSet.add(kloc);
                    }
                    {% endfor %}
                    {% endfor %}
                }
                case 1: {
                    int j = 0;
                    var loc = pastKingLocs[{{i}}][j];
                    var locX = loc.x;
                    var locY = loc.y;
                    {% for dx in range(-1, 2) %}
                    {% for dy in range(-1, 2) %}
                    {
                        var kloc = new MapLocation(locX + {{dx}}, locY + {{dy}});
                        addAlly(kloc);
                        kingSet.add(kloc);
                    }
                    {% endfor %}
                    {% endfor %}
                }
                case 0:
                default:
                    break;
            }
        }
        {% endfor %}
    }
}

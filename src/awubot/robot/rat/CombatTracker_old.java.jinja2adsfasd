package awubot.robot.rat;

import battlecode.common.Direction;
import battlecode.common.GameActionException;
import battlecode.common.MapLocation;
import battlecode.common.RobotInfo;

import static awubot.Game.*;
import static awubot.util.Util.*;

public class CombatTracker {
    /*
      CombatTracker precomputes ratnap vulnerability for each possible player end state.

      - The 5x5 around the player is tracked as isThreat booleans (passable + not trapped).
      - Traps can be registered to clear isThreat in their 3x3.
      - For each possible move (9 positions) we keep two layers of byte-packed counters:
          low: enemies with health <= ours
          high: enemies with health > ours
        Each long stores 8 per-neighbor counts (N, NE, E, SE, S, SW, W, NW) in its bytes.
      - For each enemy (dx, dy, facing) within the 5x5, if it can see a move location, it
        contributes +1 to every adjacent cell around that move location that it can reach.
      - Query combines high + (low masked by hidden neighbors for our facing), then ANDs
        with the per-move threat mask (derived from isThreat) to decide vulnerability.
      - An overload subtracts one enemy's contribution for target evaluation.
    */

    public static void tick() throws GameActionException {
        resetEnemyCounts();
        for (RobotInfo info : rc.senseNearbyRobots()) {
            if (info.getTeam() == rc.getTeam()) continue;
            int dx = info.getLocation().x - myLocX;
            int dy = info.getLocation().y - myLocY;
            boolean highHealth = info.getHealth() > rc.getHealth();
            if (highHealth) {
                registerEnemyHigh(dx, dy, info.getDirection());
            } else {
                registerEnemyLow(dx, dy, info.getDirection());
            }
        }
    }

    {% set moveDirs = directions + ['Direction.CENTER'] %}
    {% set moveShort = shortDirections + ['C'] %}
    {% set dir_dx = {
        'Direction.NORTH': 0,
        'Direction.NORTHEAST': 1,
        'Direction.EAST': 1,
        'Direction.SOUTHEAST': 1,
        'Direction.SOUTH': 0,
        'Direction.SOUTHWEST': -1,
        'Direction.WEST': -1,
        'Direction.NORTHWEST': -1,
        'Direction.CENTER': 0
    } %}
    {% set dir_dy = {
        'Direction.NORTH': 1,
        'Direction.NORTHEAST': 1,
        'Direction.EAST': 0,
        'Direction.SOUTHEAST': -1,
        'Direction.SOUTH': -1,
        'Direction.SOUTHWEST': -1,
        'Direction.WEST': 0,
        'Direction.NORTHWEST': 1,
        'Direction.CENTER': 0
    } %}
    {% set visible_dirs = {
        'Direction.NORTH': ['Direction.NORTH', 'Direction.NORTHEAST', 'Direction.NORTHWEST'],
        'Direction.SOUTH': ['Direction.SOUTH', 'Direction.SOUTHEAST', 'Direction.SOUTHWEST'],
        'Direction.EAST': ['Direction.EAST', 'Direction.NORTHEAST', 'Direction.SOUTHEAST'],
        'Direction.WEST': ['Direction.WEST', 'Direction.NORTHWEST', 'Direction.SOUTHWEST'],
        'Direction.NORTHEAST': ['Direction.NORTHEAST', 'Direction.NORTH', 'Direction.EAST'],
        'Direction.NORTHWEST': ['Direction.NORTHWEST', 'Direction.NORTH', 'Direction.WEST'],
        'Direction.SOUTHEAST': ['Direction.SOUTHEAST', 'Direction.SOUTH', 'Direction.EAST'],
        'Direction.SOUTHWEST': ['Direction.SOUTHWEST', 'Direction.SOUTH', 'Direction.WEST']
    } %}

    {% macro cell_var(dx, dy) -%}
    t_{{ "m" if dx < 0 else "" }}{{ dx|abs }}_{{ "m" if dy < 0 else "" }}{{ dy|abs }}
    {%- endmacro %}

    {% macro long_hex(val) -%}
    0x{{ "%016x"|format(val) }}L
    {%- endmacro %}

    {% macro threat_expr(dx_m, dy_m) -%}
    {%- set ns = namespace(terms=[]) -%}
    {%- for i in range(8) -%}
    {%- set ndir = directions[i] -%}
    {%- set nx = dx_m + dir_dx[ndir] -%}
    {%- set ny = dy_m + dir_dy[ndir] -%}
    {%- if nx >= -2 and nx <= 2 and ny >= -2 and ny <= 2 -%}
    {%- set term = "(" ~ cell_var(nx, ny) ~ " ? " ~ long_hex(bitLeftShift(255, i * 8)) ~ " : 0L)" -%}
    {%- set ns.terms = ns.terms + [term] -%}
    {%- endif -%}
    {%- endfor -%}
    {%- if ns.terms|length == 0 -%}
    0L
    {%- else -%}
    {{ ns.terms | join(" | ") }}
    {%- endif -%}
    {%- endmacro %}

    {% macro enemy_mask(dx_e, dy_e, facing, moveDir) -%}
    {%- set dx_m = dir_dx[moveDir] -%}
    {%- set dy_m = dir_dy[moveDir] -%}
    {%- set dx_rel = dx_m - dx_e -%}
    {%- set dy_rel = dy_m - dy_e -%}
    {%- set dist_ok = (dx_rel * dx_rel + dy_rel * dy_rel) <= 20 -%}
    {%- set ns = namespace(mask=0, visible=false) -%}
    {%- if facing == "Direction.NORTH" -%}
    {%- set ns.visible = dy_rel >= (dx_rel | abs) -%}
    {%- elif facing == "Direction.NORTHEAST" -%}
    {%- set ns.visible = dx_rel >= 0 and dy_rel >= 0 -%}
    {%- elif facing == "Direction.EAST" -%}
    {%- set ns.visible = dx_rel >= (dy_rel | abs) -%}
    {%- elif facing == "Direction.SOUTHEAST" -%}
    {%- set ns.visible = dx_rel >= 0 and dy_rel <= 0 -%}
    {%- elif facing == "Direction.SOUTH" -%}
    {%- set ns.visible = dy_rel <= -(dx_rel | abs) -%}
    {%- elif facing == "Direction.SOUTHWEST" -%}
    {%- set ns.visible = dx_rel <= 0 and dy_rel <= 0 -%}
    {%- elif facing == "Direction.WEST" -%}
    {%- set ns.visible = dx_rel <= -(dy_rel | abs) -%}
    {%- elif facing == "Direction.NORTHWEST" -%}
    {%- set ns.visible = dx_rel <= 0 and dy_rel >= 0 -%}
    {%- endif -%}
    {%- if dist_ok and ns.visible -%}
    {%- for i in range(8) -%}
    {%- set ndir = directions[i] -%}
    {%- set nx = dx_m + dir_dx[ndir] -%}
    {%- set ny = dy_m + dir_dy[ndir] -%}
    {%- set adx = (nx - dx_e) | abs -%}
    {%- set ady = (ny - dy_e) | abs -%}
    {%- if adx <= 1 and ady <= 1 -%}
    {%- set ns.mask = bitOr(ns.mask, bitLeftShift(1, i * 8)) -%}
    {%- endif -%}
    {%- endfor -%}
    {%- endif -%}
    {{ long_hex(ns.mask) }}
    {%- endmacro %}

    // isThreat flags for the 5x5 around the player.
    {% for dy in range(2, -3, -1) %}
    {% for dx in range(-2, 3) %}
    private static boolean {{ cell_var(dx, dy) }};
    {% endfor %}
    {% endfor %}

    // Byte-packed enemy counters (low/high health) per move direction.
    {% for s in moveShort %}
    private static long low{{ s }};
    {% endfor %}
    {% for s in moveShort %}
    private static long high{{ s }};
    {% endfor %}

    // Byte-packed threat masks per move direction (0xFF per reachable neighbor).
    {% for s in moveShort %}
    private static long moveThreat{{ s }};
    {% endfor %}

    // Hidden-neighbor masks per facing (0xFF for hidden, 0x00 for visible).
    {% for facing in directions %}
    {%- set ns = namespace(mask=0) -%}
    {%- for i in range(8) -%}
    {%- set dir = directions[i] -%}
    {%- if dir not in visible_dirs[facing] -%}
    {%- set ns.mask = bitOr(ns.mask, bitLeftShift(255, i * 8)) -%}
    {%- endif -%}
    {%- endfor -%}
    private static final long hidden{{ shortDirections[loop.index0] }} = {{ long_hex(ns.mask) }};
    {% endfor %}

    /* Reset all per-move enemy counters (call once per turn). */
    public static void resetEnemyCounts() {
        {% for s in moveShort %}
        low{{ s }} = 0L;
        {% endfor %}
        {% for s in moveShort %}
        high{{ s }} = 0L;
        {% endfor %}
    }

    /* Load base isThreat flags from the map around the player. */
    public static void loadThreatFromMap() throws GameActionException {
        int x = myLoc.x;
        int y = myLoc.y;
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {{ cell_var(dx, dy) }} = isCellMaybePassable(new MapLocation(x {% if dx %} + {{dx}} {% endif %}, y {% if dy %} + {{dy}} {% endif %}));
        {% endfor %}
        {% endfor %}
    }

    /* Register a trap at (dx, dy) and clear isThreat in its 3x3. */
    public static void registerTrap(int dx, int dy) {
        switch (dx) {
            {% for dx in range(-2, 3) %}
            case {{ dx }} -> {
                switch (dy) {
                    {% for dy in range(-2, 3) %}
                    case {{ dy }} -> {
                        {% for cx in range(-2, 3) %}
                        {% for cy in range(-2, 3) %}
                        {% if (cx - dx)|abs <= 1 and (cy - dy)|abs <= 1 %}
                        {{ cell_var(cx, cy) }} = false;
                        {% endif %}
                        {% endfor %}
                        {% endfor %}
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    /* Recompute per-move threat masks from current isThreat flags. */
    public static void recomputeThreatMasks() {
        {% for i in range(moveDirs|length) %}
        {%- set moveDir = moveDirs[i] -%}
        {%- set dx_m = dir_dx[moveDir] -%}
        {%- set dy_m = dir_dy[moveDir] -%}
        moveThreat{{ moveShort[i] }} = {{ threat_expr(dx_m, dy_m) }};
        {% endfor %}
    }

    /* Register one enemy robot. */
    public static void registerEnemy(RobotInfo info) {
        int dx = info.getLocation().x - myLocX;
        int dy = info.getLocation().y - myLocY;
        boolean highHealth = info.getHealth() > rc.getHealth();
        if (highHealth) {
            registerEnemyHigh(dx, dy, info.getDirection());
        } else {
            registerEnemyLow(dx, dy, info.getDirection());
        }
    }

    /* Register one low-health enemy (health <= ours). */
    public static void registerEnemyLow(int dx, int dy, Direction facing) {
        switch (dx) {
            {% for dx in range(-2, 3) %}
            case {{ dx }} -> {
                switch (dy) {
                    {% for dy in range(-2, 3) %}
                    case {{ dy }} -> {
                        switch (facing) {
                            {% for facing in directions %}
                            case {{ facing }} -> {
                                {% for i in range(moveDirs|length) %}
                                low{{ moveShort[i] }} += {{ enemy_mask(dx, dy, facing, moveDirs[i]) }};
                                {% endfor %}
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    /* Register one high-health enemy (health > ours). */
    public static void registerEnemyHigh(int dx, int dy, Direction facing) {
        switch (dx) {
            {% for dx in range(-2, 3) %}
            case {{ dx }} -> {
                switch (dy) {
                    {% for dy in range(-2, 3) %}
                    case {{ dy }} -> {
                        switch (facing) {
                            {% for facing in directions %}
                            case {{ facing }} -> {
                                {% for i in range(moveDirs|length) %}
                                high{{ moveShort[i] }} += {{ enemy_mask(dx, dy, facing, moveDirs[i]) }};
                                {% endfor %}
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    /* Return true if the move+facing has any ratnap threat after masking. */
    public static boolean hasThreat(Direction moveDir, Direction facing) {
        long low = getLowMask(moveDir);
        long high = getHighMask(moveDir);
        long hidden = getHiddenMask(facing);
        long threat = getMoveThreatMask(moveDir);
        long combined = high + (low & hidden);
        return (combined & threat) != 0L;
    }

    public static boolean hasThreat(Direction moveDir, Direction facing, RobotInfo exclude) {
        int enemyDx = exclude.getLocation().x - myLocX;
        int enemyDy = exclude.getLocation().y - myLocY;
        Direction enemyFacing = exclude.getDirection();
        boolean enemyHigh = exclude.getHealth() > rc.getHealth();
        return hasThreat(moveDir, facing, enemyDx, enemyDy, enemyFacing, enemyHigh);
    }

    /* Return true if the move+facing is threatened, excluding one registered enemy. */
    public static boolean hasThreat(Direction moveDir, Direction facing, int enemyDx, int enemyDy, Direction enemyFacing, boolean enemyHigh) {
        long low = getLowMask(moveDir);
        long high = getHighMask(moveDir);
        long hidden = getHiddenMask(facing);
        long threat = getMoveThreatMask(moveDir);
        long sub = enemyMaskForMove(enemyDx, enemyDy, enemyFacing, moveDir);
        if (enemyHigh) {
            high -= sub;
        } else {
            low -= sub;
        }
        long combined = high + (low & hidden);
        return (combined & threat) != 0L;
    }

    /* Map move direction to its low-health counter. */
    private static long getLowMask(Direction moveDir) {
        return switch (moveDir) {
            {% for i in range(moveDirs|length) %}
            case {{ moveDirs[i] }} -> low{{ moveShort[i] }};
            {% endfor %}
            default -> 0L;
        };
    }

    /* Map move direction to its high-health counter. */
    private static long getHighMask(Direction moveDir) {
        return switch (moveDir) {
            {% for i in range(moveDirs|length) %}
            case {{ moveDirs[i] }} -> high{{ moveShort[i] }};
            {% endfor %}
            default -> 0L;
        };
    }

    /* Map move direction to its threat mask. */
    private static long getMoveThreatMask(Direction moveDir) {
        return switch (moveDir) {
            {% for i in range(moveDirs|length) %}
            case {{ moveDirs[i] }} -> moveThreat{{ moveShort[i] }};
            {% endfor %}
            default -> 0L;
        };
    }

    /* Map facing direction to its hidden-neighbor mask. */
    private static long getHiddenMask(Direction facing) {
        return switch (facing) {
            {% for i in range(directions|length) %}
            case {{ directions[i] }} -> hidden{{ shortDirections[i] }};
            {% endfor %}
            default -> 0L;
        };
    }

    /* Compute this enemy's mask for a single move direction (for subtraction). */
    private static long enemyMaskForMove(int dx, int dy, Direction facing, Direction moveDir) {
        switch (dx) {
            {% for dx in range(-2, 3) %}
            case {{ dx }} -> {
                switch (dy) {
                    {% for dy in range(-2, 3) %}
                    case {{ dy }} -> {
                        switch (facing) {
                            {% for facing in directions %}
                            case {{ facing }} -> {
                                switch (moveDir) {
                                    {% for i in range(moveDirs|length) %}
                                    case {{ moveDirs[i] }} -> {
                                        return {{ enemy_mask(dx, dy, facing, moveDirs[i]) }};
                                    }
                                    {% endfor %}
                                    default -> { }
                                }
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
        return 0L;
    }
}

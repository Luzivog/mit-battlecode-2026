package awubot.robot.rat.combat;

import battlecode.common.Direction;
import battlecode.common.GameActionException;
import battlecode.common.MapInfo;
import battlecode.common.MapLocation;
import battlecode.common.RobotInfo;
import battlecode.common.TrapType;
import battlecode.common.UnitType;

import static awubot.Game.*;
import static awubot.util.Util.*;
import static awubot.robot.rat.BabyRat.*;
import awubot.util.Profiler;

{% set related_map = {
    0: ["Direction.NORTH", "Direction.NORTHEAST", "Direction.NORTHWEST"],
    1: ["Direction.NORTHEAST", "Direction.NORTH", "Direction.EAST"],
    2: ["Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHEAST"],
    3: ["Direction.SOUTHEAST", "Direction.SOUTH", "Direction.EAST"],
    4: ["Direction.SOUTH", "Direction.SOUTHEAST", "Direction.SOUTHWEST"],
    5: ["Direction.SOUTHWEST", "Direction.SOUTH", "Direction.WEST"],
    6: ["Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHWEST"],
    7: ["Direction.NORTHWEST", "Direction.NORTH", "Direction.WEST"],
} %}
{% set wide_related_map = {
    0: ["Direction.NORTH", "Direction.NORTHEAST", "Direction.NORTHWEST", "Direction.EAST", "Direction.WEST"],
    1: ["Direction.NORTHEAST", "Direction.NORTH", "Direction.EAST", "Direction.NORTHWEST", "Direction.SOUTHEAST"],
    2: ["Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHEAST", "Direction.NORTH", "Direction.SOUTH"],
    3: ["Direction.SOUTHEAST", "Direction.SOUTH", "Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHWEST"],
    4: ["Direction.SOUTH", "Direction.SOUTHEAST", "Direction.SOUTHWEST", "Direction.EAST", "Direction.WEST"],
    5: ["Direction.SOUTHWEST", "Direction.SOUTH", "Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHEAST"],
    6: ["Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHWEST", "Direction.NORTH", "Direction.SOUTH"],
    7: ["Direction.NORTHWEST", "Direction.NORTH", "Direction.WEST", "Direction.NORTHEAST", "Direction.SOUTHWEST"],
} %}
{% set dir_short_map = {
    "Direction.NORTH": "N",
    "Direction.NORTHEAST": "NE",
    "Direction.EAST": "E",
    "Direction.SOUTHEAST": "SE",
    "Direction.SOUTH": "S",
    "Direction.SOUTHWEST": "SW",
    "Direction.WEST": "W",
    "Direction.NORTHWEST": "NW",
} %}
{% set dir_ord_map = {
    "Direction.NORTH": 0,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 2,
    "Direction.SOUTHEAST": 3,
    "Direction.SOUTH": 4,
    "Direction.SOUTHWEST": 5,
    "Direction.WEST": 6,
    "Direction.NORTHWEST": 7,
} %}
{% set dir_dx = {
    "Direction.NORTH": 0,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 1,
    "Direction.SOUTHEAST": 1,
    "Direction.SOUTH": 0,
    "Direction.SOUTHWEST": -1,
    "Direction.WEST": -1,
    "Direction.NORTHWEST": -1,
} %}
{% set dir_dy = {
    "Direction.NORTH": 1,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 0,
    "Direction.SOUTHEAST": -1,
    "Direction.SOUTH": -1,
    "Direction.SOUTHWEST": -1,
    "Direction.WEST": 0,
    "Direction.NORTHWEST": 1,
} %}

{% macro wvar(dx, dy) -%}
w_{{ "m" if dx < 0 else "" }}{{ dx|abs }}_{{ "m" if dy < 0 else "" }}{{ dy|abs }}
{%- endmacro %}

{% macro delta_dir_ord(dx, dy) -%}
{%- if dx == 0 and dy == 1 -%}0
{%- elif dx == 1 and dy == 1 -%}1
{%- elif dx == 1 and dy == 0 -%}2
{%- elif dx == 1 and dy == -1 -%}3
{%- elif dx == 0 and dy == -1 -%}4
{%- elif dx == -1 and dy == -1 -%}5
{%- elif dx == -1 and dy == 0 -%}6
{%- elif dx == -1 and dy == 1 -%}7
{%- else -%}-1
{%- endif -%}
{%- endmacro %}

public final class TryTrap {
    private TryTrap() {
    }

    static boolean confirmedCanPlace;
    {% for dy in range(2, -3, -1) %}
    {% for dx in range(-2, 3) %}
    static double {{ wvar(dx, dy) }};
    {% endfor %}
    {% endfor %}
    static MapLocation bestPlaceLoc;
    static Direction bestMoveDir;
    static Direction bestFacing;
    static double best;
    static MapLocation curMoveLoc;

    public static boolean run() throws GameActionException {
        if (!confirmCanPlace()) return false;
        computeWeights();
        resetBest();
        selectMoves();
        if (best <= 0.5) return false;
        assert(CombatStrategy.performMoves(bestMoveDir, bestFacing));
        rc.placeRatTrap(bestPlaceLoc);
        println("!!!!!!!!!! placed rat trap");
        return true;
    }

    private static boolean confirmCanPlace() throws GameActionException {
        confirmedCanPlace = false;
        for (MapInfo info : rc.senseNearbyMapInfos(2)) {
            if (rc.canPlaceRatTrap(info.getMapLocation())) {
                confirmedCanPlace = true;
                break;
            }
        }
        return confirmedCanPlace;
    }

    private static void computeWeights() throws GameActionException {
        {# Profiler.push(); #}
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {{ wvar(dx, dy) }} = 0;
        {% endfor %}
        {% endfor %}
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {
            MapLocation loc = new MapLocation(myLocX {% if dx %} + {{ dx }}{% endif %}, myLocY {% if dy %} + {{ dy }}{% endif %});
            if (!rc.canSenseLocation(loc)) {
                {{ wvar(dx, dy) }} = -1000;
            } else {
                MapInfo info = rc.senseMapInfo(loc);
                if (!info.isPassable() || info.hasCheeseMine() || info.getTrap() != TrapType.NONE{% if dx != 0 or dy != 0 %} || rc.senseRobotAtLocation(loc) != null{% endif %}) {
                    {{ wvar(dx, dy) }} = -1000;
                } else {
                    {{ wvar(dx, dy) }} = 0;
                }
            }
        }
        {% endfor %}
        {% endfor %}
        for (RobotInfo rinfo : rc.senseNearbyRobots()) {
            if (rinfo.getTeam() == rc.getTeam()) continue;
            if (rinfo.getType() != UnitType.BABY_RAT) continue;
            int dx = rinfo.getLocation().x - myLocX;
            int dy = rinfo.getLocation().y - myLocY;
            if (dx < -3 || dx > 3 || dy < -3 || dy > 3) continue;
            switch (dx) {
                {% for rx in range(-3, 4) %}
                case {{ rx }} -> {
                    switch (dy) {
                        {% for ry in range(-3, 4) %}
                        case {{ ry }} -> {
                            {% if rx >= -2 and rx <= 2 and ry >= -2 and ry <= 2 %}
                            {{ wvar(rx, ry) }} += 10;
                            {% endif %}
                            switch (rinfo.getDirection().ordinal()) {
                                {% for f in range(8) %}
                                {% set ns = namespace(has=false) %}
                                {% for cx in range(-2, 3) %}
                                {% for cy in range(-2, 3) %}
                                {%- set dxo = cx - rx -%}
                                {%- set dyo = cy - ry -%}
                                {%- if dxo*dxo + dyo*dyo <= 2 and not (dxo == 0 and dyo == 0) -%}
                                {%- set dord = delta_dir_ord(dxo, dyo) | int -%}
                                {%- set diff = (f - dord) | abs -%}
                                {%- set ang = diff if diff < 8 - diff else 8 - diff -%}
                                {%- if ang <= 3 -%}
                                {%- set ns.has = true -%}
                                {%- endif -%}
                                {%- endif -%}
                                {% endfor %}
                                {% endfor %}
                                {% if ns.has %}
                                case {{ f }} -> {
                                    {% for cx in range(-2, 3) %}
                                    {% for cy in range(-2, 3) %}
                                    {%- set dxo = cx - rx -%}
                                    {%- set dyo = cy - ry -%}
                                    {%- if dxo*dxo + dyo*dyo <= 2 and not (dxo == 0 and dyo == 0) -%}
                                    {%- set dord = delta_dir_ord(dxo, dyo) | int -%}
                                    {%- set diff = (f - dord) | abs -%}
                                    {%- set ang = diff if diff < 8 - diff else 8 - diff -%}
                                    {%- if ang <= 3 -%}
                                    {{ wvar(cx, cy) }} += {{ 4 - ang }};
                                    {%- endif -%}
                                    {%- endif -%}
                                    {% endfor %}
                                    {% endfor %}
                                }
                                {% endif %}
                                {% endfor %}
                                default -> { }
                            }
                        }
                        {% endfor %}
                        default -> { }
                    }
                }
                {% endfor %}
                default -> { }
            }
        }
        {# Profiler.pop("TryTrap.computeWeights"); #}
    }

    private static void resetBest() {
        bestPlaceLoc = null;
        bestMoveDir = null;
        bestFacing = null;
        best = -1;
    }

    private static void selectMoves() throws GameActionException {
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ord}} -> {
                {% for d in wide_related_map[ord] %}
                move{{ dir_short_map[d] }}();
                {% endfor %}
            }
            {% endfor %}
            default -> { }
        }
    }

    {% for move_dir in directions %}
    private static void move{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (!CombatCommon.canMove{{ dir_short_map[move_dir] }}) return;
        curMoveLoc = myLoc.add({{ move_dir }});
        {% for facing in related_map[dir_ord_map[move_dir]] %}
        face{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}();
        {% endfor %}
    }

    {% for facing in related_map[dir_ord_map[move_dir]] %}
    private static void face{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (!CombatCommon.canPerform{{ dir_short_map[move_dir] }}_{{ dir_short_map[facing] }}) return;
        if (CombatTracker.threat{{ dir_short_map[move_dir] }}{{ dir_short_map[facing] }} != 0L) return;
        {% for place_dir in related_map[dir_ord_map[facing]] %}
        place{{ dir_short_map[place_dir] }}{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}();
        {% endfor %}
    }

    {% for place_dir in related_map[dir_ord_map[facing]] %}
    {%- set dx_total = dir_dx[move_dir] + dir_dx[place_dir] -%}
    {%- set dy_total = dir_dy[move_dir] + dir_dy[place_dir] -%}
    private static void place{{ dir_short_map[place_dir] }}{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}() {
        if ({{ wvar(dx_total, dy_total) }} >= 0) {
            double score = {{ wvar(dx_total, dy_total) }};
            if ({{ facing }} != myDir) score *= 1.1;
            if (score > best) {
                best = score;
                bestPlaceLoc = curMoveLoc.add({{ place_dir }});
                bestMoveDir = {{ move_dir }};
                bestFacing = {{ facing }};
            }
        }
    }
    {% endfor %}
    {% endfor %}
    {% endfor %}
}

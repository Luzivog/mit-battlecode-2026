import awubot.robot.rat.combat.CombatStrategy;
import static awubot.Game.*;
import static awubot.util.Util.*;
import static awubot.robot.rat.BabyRat.*;
import awubot.RobotTracker;

{% set related_map = {
    0: ["Direction.NORTH", "Direction.NORTHEAST", "Direction.NORTHWEST"],
    1: ["Direction.NORTHEAST", "Direction.NORTH", "Direction.EAST"],
    2: ["Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHEAST"],
    3: ["Direction.SOUTHEAST", "Direction.SOUTH", "Direction.EAST"],
    4: ["Direction.SOUTH", "Direction.SOUTHEAST", "Direction.SOUTHWEST"],
    5: ["Direction.SOUTHWEST", "Direction.SOUTH", "Direction.WEST"],
    6: ["Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHWEST"],
    7: ["Direction.NORTHWEST", "Direction.NORTH", "Direction.WEST"],
} %}
{% set wide_related_map = {
    0: ["Direction.NORTH", "Direction.NORTHEAST", "Direction.NORTHWEST", "Direction.EAST", "Direction.WEST"],
    1: ["Direction.NORTHEAST", "Direction.NORTH", "Direction.EAST", "Direction.NORTHWEST", "Direction.SOUTHEAST"],
    2: ["Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHEAST", "Direction.NORTH", "Direction.SOUTH"],
    3: ["Direction.SOUTHEAST", "Direction.SOUTH", "Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHWEST"],
    4: ["Direction.SOUTH", "Direction.SOUTHEAST", "Direction.SOUTHWEST", "Direction.EAST", "Direction.WEST"],
    5: ["Direction.SOUTHWEST", "Direction.SOUTH", "Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHEAST"],
    6: ["Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHWEST", "Direction.NORTH", "Direction.SOUTH"],
    7: ["Direction.NORTHWEST", "Direction.NORTH", "Direction.WEST", "Direction.NORTHEAST", "Direction.SOUTHWEST"],
} %}
{% set dir_short_map = {
    "Direction.NORTH": "N",
    "Direction.NORTHEAST": "NE",
    "Direction.EAST": "E",
    "Direction.SOUTHEAST": "SE",
    "Direction.SOUTH": "S",
    "Direction.SOUTHWEST": "SW",
    "Direction.WEST": "W",
    "Direction.NORTHWEST": "NW",
} %}
{% set dir_dx = {
    "Direction.NORTH": 0,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 1,
    "Direction.SOUTHEAST": 1,
    "Direction.SOUTH": 0,
    "Direction.SOUTHWEST": -1,
    "Direction.WEST": -1,
    "Direction.NORTHWEST": -1,
} %}
{% set dir_dy = {
    "Direction.NORTH": 1,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 0,
    "Direction.SOUTHEAST": -1,
    "Direction.SOUTH": -1,
    "Direction.SOUTHWEST": -1,
    "Direction.WEST": 0,
    "Direction.NORTHWEST": 1,
} %}
{% set dir_opposite_map = {
    "Direction.NORTH": "Direction.SOUTH",
    "Direction.NORTHEAST": "Direction.SOUTHWEST",
    "Direction.EAST": "Direction.WEST",
    "Direction.SOUTHEAST": "Direction.NORTHWEST",
    "Direction.SOUTH": "Direction.NORTH",
    "Direction.SOUTHWEST": "Direction.NORTHEAST",
    "Direction.WEST": "Direction.EAST",
    "Direction.NORTHWEST": "Direction.SOUTHEAST",
} %}

{% macro delta_dir_ord(dx, dy) -%}
{%- if dx == 0 and dy == 1 -%}0
{%- elif dx == 1 and dy == 1 -%}1
{%- elif dx == 1 and dy == 0 -%}2
{%- elif dx == 1 and dy == -1 -%}3
{%- elif dx == 0 and dy == -1 -%}4
{%- elif dx == -1 and dy == -1 -%}5
{%- elif dx == -1 and dy == 0 -%}6
{%- elif dx == -1 and dy == 1 -%}7
{%- else -%}-1
{%- endif -%}
{%- endmacro %}

{% macro select_facing_by_delta() -%}
        switch (dxToTarget) {
            {% for dx in [-1, 0, 1] %}
            case {{ dx }} -> {
                switch (dyToTarget) {
                    {% for dy in [-1, 0, 1] %}
                    case {{ dy }} -> {
                        {%- set ord = delta_dir_ord(dx, dy) | int -%}
                        {%- if ord >= 0 -%}
                        {% for facing in related_map[ord] %}
                        face{{ dir_short_map[facing] }}();
                        {% endfor %}
                        {%- endif -%}
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
{%- endmacro %}

public final class TryRatNap {
    private TryRatNap() {
    }

    static RobotInfo target;
    static RobotInfo info;
    static Direction bestMove;
    static Direction bestFacing;
    static Direction bestSecondaryMove;
    static double bestScore;
    static Direction moveDir;
    static int dxToTarget;
    static int dyToTarget;
    static double best;
    static double weight;
    static MapLocation t;

    private static int BYTECODE_BUDGET = 3000;

    // return true if successfully ratnapped someone
    // TODO: do danger levels and verify you dont die on the next turn
    public static boolean run() throws GameActionException {
        if (!rc.isActionReady()) return false;
        target = null;
        bestMove = null;
        bestFacing = null;
        bestSecondaryMove = null;
        bestScore = -1;
        int bytecodeStart = Clock.getBytecodeNum();
        for (int i = 0; i < RobotTracker.numEnemies && i < 3; i++) {
            if (Clock.getBytecodeNum() - bytecodeStart > BYTECODE_BUDGET) break;
            info = RobotTracker.sortedEnemies[i];
            t = info.location;
            if (chebyshevDistance(myLoc, t) > 2) continue;
            if (info.getHealth() <= GameConstants.RAT_BITE_DAMAGE) continue; // just kill
            if (info.getType() != UnitType.BABY_RAT) continue;
            // double weight = scoreEnemy(info);
            weight = 30;
            selectMoves();
            if (Clock.getBytecodeNum() - bytecodeStart > BYTECODE_BUDGET) break;
            selectSecondaryMoves();
        }
        if (bestScore < 0.5) return false;
        if (bestMove != null) {
            assert(CombatStrategy.performMoves(bestMove, bestFacing));
            if (rc.canCarryRat(target.location)) {
                rc.carryRat(target.location);
            } else {
                attack(target);
            }
        } else {
            if (rc.canCarryRat(target.location)) {
                rc.carryRat(target.location);
            } else {
                attack(target);
            }
            assert(CombatStrategy.performMoves(bestSecondaryMove, bestFacing));
        }
        println("!!!!!!!!!!!!!!!!!!!!!!! napped rat");
        indicate("COMBAT STRAT: NAP");
        return true;
    }

    private static void selectMoves() throws GameActionException {
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ ord }} -> {
                {% for d in wide_related_map[ord] %}
                move{{ dir_short_map[d] }}();
                {% endfor %}
            }
            {% endfor %}
            default -> { }
        }
    }

    {% for move_dir in directions %}
    private static void move{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (!CombatCommon.canMove{{ dir_short_map[move_dir] }}) return;
        moveDir = {{ move_dir }};
        dxToTarget = t.x - (myLocX {% if dir_dx[move_dir] %} + {{ dir_dx[move_dir] }}{% endif %});
        dyToTarget = t.y - (myLocY {% if dir_dy[move_dir] %} + {{ dir_dy[move_dir] }}{% endif %});
        if (dxToTarget * dxToTarget + dyToTarget * dyToTarget > 2) return;
        if (info.getHealth() >= rc.getHealth() && canSense(-dxToTarget, -dyToTarget, info.direction)) return; // can i ratnap this guy
{{ select_facing_by_delta() }}
    }

    {% endfor %}
    {% for face_dir in directions %}
    private static void face{{ dir_short_map[face_dir] }}() throws GameActionException {
        if (!canSense(dxToTarget, dyToTarget, {{ face_dir }})) return;
        if (!CombatCommon.canPerformMoves(moveDir, {{ face_dir }})) return;
        double score = weight;
        score += CombatStrategy.getCellScoreFor(moveDir, {{ face_dir }}, info);
        if (score <= 0.5) return;
        if ({{ face_dir }} != myDir) {
            score *= 1.2; // prefer turning
        }
        if (score > bestScore) {
            bestScore = score;
            target = info;
            bestMove = moveDir;
            bestFacing = {{ face_dir }};
            bestSecondaryMove = null;
        }
    }

    {% endfor %}
    private static void selectSecondaryMoves() throws GameActionException {
        int dx = t.x - myLocX;
        int dy = t.y - myLocY;
        if (dx * dx + dy * dy > 2) return;
        if (info.getHealth() >= rc.getHealth()) return; // can i ratnap this guy
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ ord }} -> {
                {% set related = related_map[ord] %}
                {% for facing in related %}
                {% for move_dir in related %}
                considerSecondaryMove({{ dir_opposite_map[move_dir] }}, {{ facing }});
                {% endfor %}
                {% endfor %}
            }
            {% endfor %}
            default -> { }
        }
    }

    private static void considerSecondaryMove(Direction moveDir, Direction facing) throws GameActionException {
        if (!CombatCommon.canPerformMoves(moveDir, facing)) return;
        double score = weight + 5;
        score += CombatStrategy.getCellScoreFor(moveDir, facing, info);
        if (score <= 0.5) return;
        if (facing != myDir) {
            score *= 1.2; // prefer turning
        }
        if (score > bestScore) {
            bestScore = score;
            target = info;
            bestMove = null;
            bestFacing = facing;
            bestSecondaryMove = moveDir;
        }
    }

    public static boolean miniRun() throws GameActionException {
        // first try to nap a rat looking at us
        for (int i = 0; i < RobotTracker.numEnemies && i < 3; i++) {
            info = RobotTracker.sortedEnemies[i];
            if (info.getTeam() == team) continue;
            if (info.location.distanceSquaredTo(myLoc) > 2) continue;
            if (info.getHealth() <= GameConstants.RAT_BITE_DAMAGE) continue; // just kill
            if (info.getType() != UnitType.BABY_RAT) continue;
            int dx = info.location.x - myLocX;
            int dy = info.location.y - myLocY;
            if (canSense(dx, dy, info.direction)) {
                if (rc.canCarryRat(info.location)) {
                    rc.carryRat(info.location);
                    println("!!!!!!!!!!!!!!!!!!!!!!! mini napped rat");
                    return true;
                }
            }
        }
        // nap anyone
        for (RobotInfo info : rc.senseNearbyRobots(2)) {
            if (info.getTeam() == team) continue;
            if (info.getHealth() <= GameConstants.RAT_BITE_DAMAGE) continue; // just kill
            if (info.getType() != UnitType.BABY_RAT) continue;
            if (rc.canCarryRat(info.location)) {
                rc.carryRat(info.location);
                println("!!!!!!!!!!!!!!!!!!!!!!! mini napped rat");
                indicate("COMBAT STRAT: MINI NAP");
                return true;
            }
        }
        return false;
    }
}

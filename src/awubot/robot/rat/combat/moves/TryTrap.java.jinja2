{% macro wvar(dx, dy) -%}
w_{{ "m" if dx < 0 else "" }}{{ dx|abs }}_{{ "m" if dy < 0 else "" }}{{ dy|abs }}
{%- endmacro %}

{% macro delta_dir_ord(dx, dy) -%}
{%- if dx == 0 and dy == 1 -%}0
{%- elif dx == 1 and dy == 1 -%}1
{%- elif dx == 1 and dy == 0 -%}2
{%- elif dx == 1 and dy == -1 -%}3
{%- elif dx == 0 and dy == -1 -%}4
{%- elif dx == -1 and dy == -1 -%}5
{%- elif dx == -1 and dy == 0 -%}6
{%- elif dx == -1 and dy == 1 -%}7
{%- else -%}-1
{%- endif -%}
{%- endmacro %}

public final class TryTrap {
    private TryTrap() {
    }

    static boolean confirmedCanPlace;
    {% for dy in range(2, -3, -1) %}
    {% for dx in range(-2, 3) %}
    static double {{ wvar(dx, dy) }};
    {% endfor %}
    {% endfor %}
    static MapLocation bestPlaceLoc;
    static Direction bestMoveDir;
    static Direction bestSecondaryMoveDir;
    static Direction bestFacing;
    static double best;
    static double baseScore;
    static MapLocation curMoveLoc;
    static RobotInfo target;
    static int targetDx, targetDy;
    static Direction targetDir;
    static int bytecodeStart, bytecodeBudget;
    static boolean shouldDefRun;

    public static boolean verifyCanRun() throws GameActionException {
        if (!rc.isActionReady() || !confirmCanPlace()) return false;
        return true;
    }

    public static boolean globalShouldRun() throws GameActionException {
        // global
        if (rc.getAllCheese() > 3000 || rc.getRawCheese() >= 20) return true;
        return false;
    }

    public static boolean shouldTrap(RobotInfo info) throws GameActionException {
        if (info.getHealth() >= 80 && info.getHealth() >= rc.getHealth() + CombatStrategy.getMaxBiteDamage() || info.getHealth() == 100) {
            println("ACCEPEETD CONIDIOTOINIS A;PLOSDKJF;LKAJSDAF;LKJASDA;LKFJDSA;DLKFJSD;LKFJA;SLKDFJ;SLAKJDFL;K");
            return true;
        }
        return false;
    }

    public static boolean shouldRunEarlyExit() throws GameActionException {
        for (int i = 0; i < RobotTracker.numEnemies && i < 3; i++) {
            RobotInfo info = RobotTracker.sortedEnemies[i];
            if (info.getType() != UnitType.BABY_RAT) continue;
            if (shouldTrap(info)) return true;
        }
        return false;
    }

    public static boolean run() throws GameActionException {
        if (!verifyCanRun()) return false;
        shouldDefRun = globalShouldRun();
        if (!shouldDefRun && !shouldRunEarlyExit()) return false;

        bytecodeStart = Clock.getBytecodeNum();
        bytecodeBudget = Math.min(6000, (int) (Clock.getBytecodesLeft() - 1000) / 2);
        computeWeights();
        resetBest();
        selectMoves();
        if (bestPlaceLoc == null) return false;
        if (best < 0.5) return false;
        println("placing trap on " + bestPlaceLoc + " with score " + best);
        println("choices: move " + bestMoveDir + ", secondary move " + bestSecondaryMoveDir + ", facing " + bestFacing);
        if (bestMoveDir != null) {
            if (rc.canPlaceRatTrap(bestPlaceLoc)) rc.placeRatTrap(bestPlaceLoc);
            assert(CombatStrategy.performMoves(bestMoveDir, bestFacing));
            if (rc.canPlaceRatTrap(bestPlaceLoc)) rc.placeRatTrap(bestPlaceLoc);
        } else {
            rc.placeRatTrap(bestPlaceLoc);
            assert(CombatStrategy.performMoves(bestSecondaryMoveDir, bestFacing));
        }
        println("!!!!!!!!!! placed rat trap");
        indicate("COMBAT STRAT: TRAP");
        return true;
    }

    private static boolean confirmCanPlace() throws GameActionException {
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ ord }} -> {
                {% for d in related_map[ord] %}
                if (rc.canPlaceRatTrap(myLoc.add({{ d }}))) {
                    return true;
                }
                {% endfor %}
            }
            {% endfor %}
            default -> { }
        }
        return false;
    }

    // has room for optimisation if reallllyyy needed
    private static void computeWeights() throws GameActionException {
        {# Profiler.push(); #}
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {
            MapLocation loc = new MapLocation(myLocX {% if dx %} + {{ dx }}{% endif %}, myLocY {% if dy %} + {{ dy }}{% endif %});
            if (!rc.canSenseLocation(loc)) {
                {{ wvar(dx, dy) }} = -1000;
            } else {
                MapInfo info = rc.senseMapInfo(loc);
                if (!info.isPassable() || info.hasCheeseMine(){% if dx != 0 or dy != 0 %} || rc.senseRobotAtLocation(loc) != null{% endif %}) {
                    {{ wvar(dx, dy) }} = -1000;
                } else {
                    {{ wvar(dx, dy) }} = 0;
                }
            }
        }
        {% endfor %}
        {% endfor %}

        applyTrapWeights();
        applyEnemyWeights();

        {# Profiler.pop("TryTrap.computeWeights"); #}
    }

    private static void clearWeights() {
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {{ wvar(dx, dy) }} = 0;
        {% endfor %}
        {% endfor %}
    }

    private static void applyEnemyWeights() throws GameActionException {
        for (int i = 0; i < RobotTracker.numEnemies && i < 5; i++) {
            RobotInfo info = RobotTracker.sortedEnemies[i];
            if (info.getType() != UnitType.BABY_RAT) continue;
            applyEnemyWeight(info);
        }
    }

    private static double getWeight(int dx, int dy) {
        switch (dx) {
            {% for dx_case in range(-2, 3) %}
            case {{ dx_case }} -> {
                switch (dy) {
                    {% for dy_case in range(-2, 3) %}
                    case {{ dy_case }} -> {
                        return {{ wvar(dx_case, dy_case) }};
                    }
                    {% endfor %}
                    default -> { return -1000; }
                }
            }
            {% endfor %}
            default -> { return -1000; }
        }
    }

    private static void applyEnemyWeight(RobotInfo rinfo) throws GameActionException {
        if (shouldDefRun) return;
        if (shouldTrap(rinfo)) return;
        int x = rinfo.location.x - myLocX;
        int y = rinfo.location.y - myLocY;
        switch (x) {
            {% for dx in range(-3, 4) %}
            case {{ dx }} -> {
                switch (y) {
                    {% for dy in range(-3, 4) %}
                    case {{ dy }} -> {
                        switch (rinfo.direction.ordinal()) {
                            {% for f in range(8) %}
                            case {{ f }} -> {
                                {% set dir = directions[f] %}
                                {% for off in range(0, 2) %}
                                    {% for relDir in related_map[dir] %}
                                        {% set cx = dx + dir_dx[relDir] + off * dir_dx[dir] %}
                                        {% set cy = dy + dir_dy[relDir] + off * dir_dy[dir] %}
                                        {% if cx >= -2 and cx <= 2 and cy >= -2 and cy <= 2 %}
                                            {{ wvar(dx, dy) }} -= 10;
                                        {% endif %}
                                    {% endfor %}
                                {% endfor %}
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    public static MapLocation nearbyRatTraps[] = new MapLocation[30];
    public static int numNearbyRatTraps = 0;

    private static void applyTrapWeights() {
        numNearbyRatTraps = 0;
        for (MapInfo info : rc.senseNearbyMapInfos()) {
            if (info.getTrap() == TrapType.RAT_TRAP) {
                nearbyRatTraps[numNearbyRatTraps++] = info.getMapLocation();
            }
        } 
        indicate("Found " + numNearbyRatTraps + " nearby rat traps");
        switch (numNearbyRatTraps) {
            {% for i in range(29, 0, -1) %}
            case {{ i }}: {
                MapLocation trapLoc = nearbyRatTraps[{{ i - 1 }}];
                int x = trapLoc.x - myLocX;
                int y = trapLoc.y - myLocY;
                applyTrapWeight(x, y);
            } 
            {% endfor %}
            case 0:
                break;
            default:
                assert(false);
                break;
        }
    }

    private static void applyTrapWeight(int x, int y) {
        switch (x) {
            {% for dx in range(-2, 3) %}
            case {{ dx }} -> {
                switch (y) {
                    {% for dy in range(-2, 3) %}
                    case {{ dy }} -> {
                        {% for nx in range(dx - 1, dx + 2) %}
                        {% for ny in range(dy - 1, dy + 2) %}
                        {%- if nx >= -2 and nx <= 2 and ny >= -2 and ny <= 2 -%}
                        {# println("marked cell at " + x + ", " + y + " due to trap at " + x + ", " + y); #}
                        {{ wvar(nx, ny) }} -= 1000;
                        {%- endif -%}
                        {% endfor %}
                        {% endfor %}
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    private static void resetBest() {
        bestPlaceLoc = null;
        bestMoveDir = null;
        bestSecondaryMoveDir = null;
        bestFacing = null;
        best = -1e9;
    }

    private static void selectMoves() throws GameActionException {
        for (int i = 0; i < RobotTracker.numEnemies && i < 3; i++) {
            target = RobotTracker.sortedEnemies[i];
            if (target.getType() != UnitType.BABY_RAT || !shouldTrap(target)) continue;
            targetDx = target.getLocation().x - myLocX;
            targetDy = target.getLocation().y - myLocY;
            targetDir = target.getDirection();
            switch (myDir.ordinal()) {
                {% for ord in range(8) %}
                case {{ ord }} -> {
                    {% set facing = directions[ord] %}
                    {% set ordered_dirs = get_movements(facing) %}
                    {% for move_dir, is_wide_related in ordered_dirs %}
                        {% if is_wide_related %}
                            move{{ dir_short_map[move_dir] }}();
                            if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) return;
                        {% else %}
                        {% for facing_dir in related_map[ord] %}
                            considerSecondaryMove{{ dir_short_map[move_dir] }}{{ dir_short_map[facing_dir] }}();
                            if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) return;
                        {% endfor %}
                        {% endif %}
                    {% endfor %}
                }
                {% endfor %}
                default -> { }
            }
        }
    }

{% macro considerSecondary(offX, offY, enemy_dx, enemy_dy, move_dir, facing) %}
{% set new_enemy_dx = enemy_dx - dir_dx[move_dir] -%}
{% set new_enemy_dy = enemy_dy - dir_dy[move_dir] -%}
{% if (offX != 0 or offY != 0) and (new_enemy_dx|abs > 1 or new_enemy_dy|abs > 1) and offX|abs <= 1 and offY|abs <= 1 and can_see(dir_ord_map[facing], offX, offY) == "true" and can_see(dir_ord_map[facing], offX, offY) == "true" %}
{
    {%- set x0 = dir_dx[move_dir] - offX -%}
    {%- set y0 = dir_dy[move_dir] - offY -%}
    {%- set x1 = enemy_dx - offX -%}
    {%- set y1 = enemy_dy - offY -%}
    double score = baseScore + {{ wvar(offX, offY) }} + {{ ((x1 * x1 + y1 * y1) ** 0.5 + (x0 * x0 + y0 * y0) ** 0.5) / 10.0 }};
    if ({{ facing }} != myDir) score += 2;
    if (score > best) {
        best = score;
        bestPlaceLoc = myLoc.translate({{ offX }}, {{ offY }});
        bestMoveDir = null;
        bestSecondaryMoveDir = {{ move_dir }};
        bestFacing = {{ facing }};
    }
}
{% endif %}
{% endmacro %}

// TODO: allow move back + place trap in front

    {% for move_dir in directions %}
    {% for facing in directions %}
    private static void considerSecondaryMove{{ dir_short_map[move_dir] }}{{ dir_short_map[facing] }}() throws GameActionException {
        int moveCost = CombatCommon.movementCost({{ move_dir }}, {{ facing }});
        if (moveCost == -1) return;
        baseScore = CombatStrategy.getCellScoreFor({{ move_dir }}, {{ facing }}, target, 50);
        switch (targetDir.ordinal()) {
            {% for diri in range(8) %}
            case {{ diri }} -> {
                switch (targetDx) {
                    {% for dx in range(-4, 5) %}
                    case {{ dx }} -> {
                        switch (targetDy) {
                            {% for dy in range(-4, 5) %}
                            case {{ dy }} -> {
                                {% if can_see(diri, -dx, -dy) == "true" %}
                                    {# enemy must be able to see you #}
                                    {% for offDir in related_map[diri] %}            
                                        {% for mul in range(0, 1) %} {# only consider related directions #}
                                            {% set offX = dx + dir_dx[offDir] + mul * dir_dx[directions[diri]] -%}
                                            {% set offY = dy + dir_dy[offDir] + mul * dir_dy[directions[diri]] -%}
                                            {{ considerSecondary(offX, offY, dx, dy, move_dir, facing) }}
                                        {% endfor %}
                                    {% endfor %}
                                {% endif %}
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                }
            }
            {% endfor %}
        }
    }
    {% endfor %}
    {% endfor %}

    {% for move_dir in allDirections %}
    private static void move{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (!CombatCommon.canMove{{ dir_short_map[move_dir] }}) return;
        curMoveLoc = myLoc.add({{ move_dir }});
        {% for facing in related_map[dir_ord_map[move_dir]] %}
        face{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}();
        if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) return;
        {% endfor %}
    }

{% macro consider(offX, offY, enemy_dx, enemy_dy, move_dir, facing) %}
{% set newOffX = offX - dir_dx[move_dir] -%}
{% set newOffY = offY - dir_dy[move_dir] -%}
{% set new_enemy_dx = enemy_dx - dir_dx[move_dir] -%}
{% set new_enemy_dy = enemy_dy - dir_dy[move_dir] -%}
{% if (offX != 0 or offY != 0) and (new_enemy_dx|abs > 1 or new_enemy_dy|abs > 1) and newOffX|abs <= 1 and newOffY|abs <= 1 and can_see(dir_ord_map[facing], newOffX, newOffY) == "true" and can_see(dir_ord_map[facing], offX, offY) == "true" %}
{
    {%- set x0 = dir_dx[move_dir] - offX -%}
    {%- set y0 = dir_dy[move_dir] - offY -%}
    {%- set x1 = enemy_dx - offX -%}
    {%- set y1 = enemy_dy - offY -%}
    {# inserted +5 here #}
    double score = baseScore + {{ wvar(offX, offY) }} + {{ 5 + ((x1 * x1 + y1 * y1) ** 0.5 + (x0 * x0 + y0 * y0) ** 0.5) / 10.0 }};
    if ({{ facing }} != myDir) score += 2;
    if (score > best) {
        best = score;
        bestPlaceLoc = myLoc.translate({{ offX }}, {{ offY }});
        bestMoveDir = {{ move_dir }};
        bestSecondaryMoveDir = null;
        bestFacing = {{ facing }};
    }
}
{% endif %}
{% endmacro %}

    {% for facing in related_map[dir_ord_map[move_dir]] %}
    private static void face{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}() throws GameActionException {
        int moveCost = CombatCommon.movementCost({{ move_dir }}, {{ facing }});
        if (moveCost == -1) return;
        baseScore = CombatStrategy.getCellScoreFor({{ move_dir }}, {{ facing }}, target, 50);
        if (moveCost == 1) baseScore += 2;
        switch (targetDir.ordinal()) {
            {% for diri in range(8) %}
            case {{ diri }} -> {
                switch (targetDx) {
                    {% for dx in range(-4, 5) %}
                    case {{ dx }} -> {
                        switch (targetDy) {
                            {% for dy in range(-4, 5) %}
                            case {{ dy }} -> {
                                {% if can_see(diri, -(dx - dir_dx[move_dir]), -(dy - dir_dy[move_dir])) == "true" %}
                                    {# enemy must be able to see you #}
                                    {% for offDir in related_map[diri] %}            
                                        {% for mul in range(0, 1) %} {# only consider related directions #}
                                            {% set offX = dx + dir_dx[offDir] + mul * dir_dx[directions[diri]] -%}
                                            {% set offY = dy + dir_dy[offDir] + mul * dir_dy[directions[diri]] -%}
                                            {{ consider(offX, offY, dx, dy, move_dir, facing) }}
                                        {% endfor %}
                                    {% endfor %}
                                {% endif %}
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                }
            }
            {% endfor %}
        }
    }
    {% endfor %}
    {% endfor %}

    public static boolean miniRun() throws GameActionException {
        if (!verifyCanRun()) return false;
        shouldDefRun = globalShouldRun();
        int x = myLocX;
        int y = myLocY;
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ ord }} -> {
                {% set cand = related_map[ord] %}
                {% for d in cand %}
                MapLocation loc{{ loop.index0 }} = new MapLocation(x {% if dir_dx[d] %} + {{ dir_dx[d] }}{% endif %}, y {% if dir_dy[d] %} + {{ dir_dy[d] }}{% endif %});
                double s{{ loop.index0 }} = 0;
                {% endfor %}
                for (int i = 0; i < RobotTracker.numEnemies && i < 2; i++) {
                    RobotInfo rinfo = RobotTracker.sortedEnemies[i];
                    if (!shouldDefRun && !shouldTrap(rinfo)) continue;
                    if (rinfo.location.distanceSquaredTo(myLoc) > 2) break;
                    MapLocation eloc = rinfo.location;
                    {
                        if (eloc.distanceSquaredTo(loc0) <= 2) {
                            int ang = angleDistance(rinfo.direction, eloc.directionTo(loc0));
                            if (ang <= 3) s0 += 4 - ang;
                        }
                    }
                    {
                        if (eloc.distanceSquaredTo(loc1) <= 2) {
                            int ang = angleDistance(rinfo.direction, eloc.directionTo(loc1));
                            if (ang <= 3) s1 += 4 - ang;
                        }
                    }
                    {
                        if (eloc.distanceSquaredTo(loc2) <= 2) {
                            int ang = angleDistance(rinfo.direction, eloc.directionTo(loc2));
                            if (ang <= 3) s2 += 4 - ang;
                        }
                    }
                }
                double bestScore = -1;
                MapLocation bestLoc = null;
                if (rc.canPlaceRatTrap(loc0) && s0 > bestScore) {
                    bestScore = s0;
                    bestLoc = loc0;
                }
                if (rc.canPlaceRatTrap(loc1) && s1 > bestScore) {
                    bestScore = s1;
                    bestLoc = loc1;
                }
                if (rc.canPlaceRatTrap(loc2) && s2 > bestScore) {
                    bestScore = s2;
                    bestLoc = loc2;
                }
                if (bestScore <= 0) return false;
                rc.placeRatTrap(bestLoc);
                println("!!!!!!!!!! placed rat trap MINI");
                indicate("COMBAT STRAT: MINI TRAP");
                return true;
            }
            {% endfor %}    
            default -> { return false; }
        }
    }
}

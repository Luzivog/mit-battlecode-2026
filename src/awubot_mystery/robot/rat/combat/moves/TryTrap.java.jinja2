import awubot_mystery.RobotTracker;

{% set related_map = {
    0: ["Direction.NORTH", "Direction.NORTHEAST", "Direction.NORTHWEST"],
    1: ["Direction.NORTHEAST", "Direction.NORTH", "Direction.EAST"],
    2: ["Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHEAST"],
    3: ["Direction.SOUTHEAST", "Direction.SOUTH", "Direction.EAST"],
    4: ["Direction.SOUTH", "Direction.SOUTHEAST", "Direction.SOUTHWEST"],
    5: ["Direction.SOUTHWEST", "Direction.SOUTH", "Direction.WEST"],
    6: ["Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHWEST"],
    7: ["Direction.NORTHWEST", "Direction.NORTH", "Direction.WEST"],
} %}
{% set wide_related_map = {
    0: ["Direction.NORTH", "Direction.NORTHEAST", "Direction.NORTHWEST", "Direction.EAST", "Direction.WEST"],
    1: ["Direction.NORTHEAST", "Direction.NORTH", "Direction.EAST", "Direction.NORTHWEST", "Direction.SOUTHEAST"],
    2: ["Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHEAST", "Direction.NORTH", "Direction.SOUTH"],
    3: ["Direction.SOUTHEAST", "Direction.SOUTH", "Direction.EAST", "Direction.NORTHEAST", "Direction.SOUTHWEST"],
    4: ["Direction.SOUTH", "Direction.SOUTHEAST", "Direction.SOUTHWEST", "Direction.EAST", "Direction.WEST"],
    5: ["Direction.SOUTHWEST", "Direction.SOUTH", "Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHEAST"],
    6: ["Direction.WEST", "Direction.NORTHWEST", "Direction.SOUTHWEST", "Direction.NORTH", "Direction.SOUTH"],
    7: ["Direction.NORTHWEST", "Direction.NORTH", "Direction.WEST", "Direction.NORTHEAST", "Direction.SOUTHWEST"],
} %}
{% set dir_short_map = {
    "Direction.NORTH": "N",
    "Direction.NORTHEAST": "NE",
    "Direction.EAST": "E",
    "Direction.SOUTHEAST": "SE",
    "Direction.SOUTH": "S",
    "Direction.SOUTHWEST": "SW",
    "Direction.WEST": "W",
    "Direction.NORTHWEST": "NW",
} %}
{% set dir_ord_map = {
    "Direction.NORTH": 0,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 2,
    "Direction.SOUTHEAST": 3,
    "Direction.SOUTH": 4,
    "Direction.SOUTHWEST": 5,
    "Direction.WEST": 6,
    "Direction.NORTHWEST": 7,
} %}
{% set dir_dx = {
    "Direction.NORTH": 0,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 1,
    "Direction.SOUTHEAST": 1,
    "Direction.SOUTH": 0,
    "Direction.SOUTHWEST": -1,
    "Direction.WEST": -1,
    "Direction.NORTHWEST": -1,
} %}
{% set dir_dy = {
    "Direction.NORTH": 1,
    "Direction.NORTHEAST": 1,
    "Direction.EAST": 0,
    "Direction.SOUTHEAST": -1,
    "Direction.SOUTH": -1,
    "Direction.SOUTHWEST": -1,
    "Direction.WEST": 0,
    "Direction.NORTHWEST": 1,
} %}

{% macro can_see(facing_idx, dx, dy) -%}
{%- set facing = directions[facing_idx] -%}
{%- if facing == "Direction.NORTH" -%}
{{ "true" if dy >= (dx | abs) else "false" }}
{%- elif facing == "Direction.NORTHEAST" -%}
{{ "true" if dx >= 0 and dy >= 0 else "false" }}
{%- elif facing == "Direction.EAST" -%}
{{ "true" if dx >= (dy | abs) else "false" }}
{%- elif facing == "Direction.SOUTHEAST" -%}
{{ "true" if dx >= 0 and dy <= 0 else "false" }}
{%- elif facing == "Direction.SOUTH" -%}
{{ "true" if dy <= -(dx | abs) else "false" }}
{%- elif facing == "Direction.SOUTHWEST" -%}
{{ "true" if dx <= 0 and dy <= 0 else "false" }}
{%- elif facing == "Direction.WEST" -%}
{{ "true" if dx <= -(dy | abs) else "false" }}
{%- elif facing == "Direction.NORTHWEST" -%}
{{ "true" if dx <= 0 and dy >= 0 else "false" }}
{%- else -%}
false
{%- endif -%}
{%- endmacro %}

{% macro wvar(dx, dy) -%}
w_{{ "m" if dx < 0 else "" }}{{ dx|abs }}_{{ "m" if dy < 0 else "" }}{{ dy|abs }}
{%- endmacro %}

{% macro delta_dir_ord(dx, dy) -%}
{%- if dx == 0 and dy == 1 -%}0
{%- elif dx == 1 and dy == 1 -%}1
{%- elif dx == 1 and dy == 0 -%}2
{%- elif dx == 1 and dy == -1 -%}3
{%- elif dx == 0 and dy == -1 -%}4
{%- elif dx == -1 and dy == -1 -%}5
{%- elif dx == -1 and dy == 0 -%}6
{%- elif dx == -1 and dy == 1 -%}7
{%- else -%}-1
{%- endif -%}
{%- endmacro %}

public final class TryTrap {
    private TryTrap() {
    }

    static boolean confirmedCanPlace;
    {% for dy in range(2, -3, -1) %}
    {% for dx in range(-2, 3) %}
    static double {{ wvar(dx, dy) }};
    {% endfor %}
    {% endfor %}
    static MapLocation bestPlaceLoc;
    static Direction bestMoveDir;
    static Direction bestFacing;
    static double best;
    static MapLocation curMoveLoc;
    static MapLocation weightSource;
    static int weightCompTime;
    static int bytecodeStart, bytecodeBudget;

    public static boolean run() throws GameActionException {
        if (rc.getAllCheese() < 300 || rc.getRawCheese() < 20 || !confirmCanPlace()) return false;
        bytecodeStart = Clock.getBytecodeNum();
        bytecodeBudget = Math.min(3000, (int) (Clock.getBytecodesLeft() - 1000) / 2);
        Profiler.push();
        computeWeights();
        Profiler.pop("TryTrap.computeWeights");
        resetBest();
        selectMoves();
        if (best <= 0.5) return false;
        assert(CombatStrategy.performMoves(bestMoveDir, bestFacing));
        if (!rc.canPlaceRatTrap(bestPlaceLoc)) {
            {# println("huh cant place trap here  " + bestPlaceLoc);
            for (int i = 0; i < CellTracker.numNearbyRatTraps; i++) {
                println("nearby trap at " + CellTracker.nearbyRatTraps[i]);
            } #}
            {# rc.resign(); #}
        }
        rc.placeRatTrap(bestPlaceLoc);
        println("!!!!!!!!!! placed rat trap");
        indicate("COMBAT STRAT: TRAP");
        return true;
    }

    private static boolean confirmCanPlace() throws GameActionException {
        confirmedCanPlace = false;
        for (MapInfo info : rc.senseNearbyMapInfos(2)) {
            if (rc.canPlaceRatTrap(info.getMapLocation())) {
                confirmedCanPlace = true;
                break;
            }
        }
        return confirmedCanPlace;
    }

    // has room for optimisation if reallllyyy needed
    private static void computeWeights() throws GameActionException {
        {# Profiler.push(); #}
        weightCompTime = time;
        weightSource = myLoc;
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {
            MapLocation loc = new MapLocation(myLocX {% if dx %} + {{ dx }}{% endif %}, myLocY {% if dy %} + {{ dy }}{% endif %});
            if (!rc.canSenseLocation(loc)) {
                {{ wvar(dx, dy) }} = -1000;
            } else {
                MapInfo info = rc.senseMapInfo(loc);
                if (!info.isPassable() || info.hasCheeseMine(){% if dx != 0 or dy != 0 %} || rc.senseRobotAtLocation(loc) != null{% endif %}) {
                    {{ wvar(dx, dy) }} = -1000;
                } else {
                    {{ wvar(dx, dy) }} = 0;
                }
            }
        }
        {% endfor %}
        {% endfor %}

        applyTrapWeights();
        applyEnemyWeights();

        {# Profiler.pop("TryTrap.computeWeights"); #}
    }

    private static void clearWeights() {
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {{ wvar(dx, dy) }} = 0;
        {% endfor %}
        {% endfor %}
    }

    private static void applyEnemyWeights() {
        for (int i = 0; i < RobotTracker.numEnemies && i < 5; i++) {
            RobotInfo info = RobotTracker.sortedEnemies[i];
            if (info.getType() != UnitType.BABY_RAT) continue;
            applyEnemyWeight(info);
        }
    }

    private static double getWeight(int dx, int dy) {
        switch (dx) {
            {% for dx_case in range(-2, 3) %}
            case {{ dx_case }} -> {
                switch (dy) {
                    {% for dy_case in range(-2, 3) %}
                    case {{ dy_case }} -> {
                        return {{ wvar(dx_case, dy_case) }};
                    }
                    {% endfor %}
                    default -> { return -1000; }
                }
            }
            {% endfor %}
            default -> { return -1000; }
        }
    }

    private static void applyEnemyWeight(RobotInfo rinfo) {
        if (rinfo.getHealth() <= 30) return;
        int x = rinfo.location.x - myLocX;
        int y = rinfo.location.y - myLocY;
        switch (x) {
            {% for dx in range(-3, 4) %}
            case {{ dx }} -> {
                switch (y) {
                    {% for dy in range(-3, 4) %}
                    case {{ dy }} -> {
                        switch (rinfo.direction.ordinal()) {
                            {% for f in range(8) %}

                            case {{ f }} -> {
                                {% if can_see(f, -dx, -dy) == "true" %}

                                {% for cx in range(-2, 3) %}
                                {% for cy in range(-2, 3) %}
                                {%- set dxo = cx - dx -%}
                                {%- set dyo = cy - dy -%}
                                {%- if dxo*dxo + dyo*dyo <= 2 and not (dxo == 0 and dyo == 0) -%}
                                {%- set dord = delta_dir_ord(dxo, dyo) | int -%}
                                {%- set diff = (f - dord) | abs -%}
                                {%- set ang = diff if diff < 8 - diff else 8 - diff -%}
                                {%- if ang <= 1 -%}
                                {{ wvar(cx, cy) }} += {{ 3 - ang }};
                                {# println("incremented weight at " + (myLocX + {{cx}}) + ", " + (myLocY + {{cy}})); #}
                                {%- endif -%}
                                {%- endif -%}
                                {% endfor %}
                                {% endfor %}

                                {%- endif -%}
                            }
                            {% endfor %}
                            default -> { }
                        }
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    private static void applyTrapWeights() {
        switch (CellTracker.numNearbyRatTraps) {
            {% for i in range(29, 0, -1) %}
            case {{ i }}: {
                MapLocation trapLoc = CellTracker.nearbyRatTraps[{{ i - 1 }}];
                int x = trapLoc.x - myLocX;
                int y = trapLoc.y - myLocY;
                applyTrapWeight(x, y);
            } 
            {% endfor %}
            case 0:
                break;
            default:
                assert(false);
                break;
        }
    }

    private static void applyTrapWeight(int x, int y) {
        // println("\napplying trap weight for trap at " + x + ", " + y + "\n");
        switch (x) {
            {% for dx in range(-2, 3) %}
            case {{ dx }} -> {
                switch (y) {
                    {% for dy in range(-2, 3) %}
                    case {{ dy }} -> {
                        {% for nx in range(dx - 1, dx + 2) %}
                        {% for ny in range(dy - 1, dy + 2) %}
                        {%- if nx >= -2 and nx <= 2 and ny >= -2 and ny <= 2 -%}
                        {# println("marked cell at " + x + ", " + y + " due to trap at " + x + ", " + y); #}
                        {{ wvar(nx, ny) }} -= 100;
                        {%- endif -%}
                        {% endfor %}
                        {% endfor %}
                    }
                    {% endfor %}
                    default -> { }
                }
            }
            {% endfor %}
            default -> { }
        }
    }

    private static void resetBest() {
        bestPlaceLoc = null;
        bestMoveDir = null;
        bestFacing = null;
        best = -1;
    }

    private static void selectMoves() throws GameActionException {
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ord}} -> {
                {% for d in wide_related_map[ord] %}
                if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) break;
                move{{ dir_short_map[d] }}();
                {% endfor %}
            }
            {% endfor %}
            default -> { }
        }
    }

    {% for move_dir in directions %}
    private static void move{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (!CombatCommon.canMove{{ dir_short_map[move_dir] }}) return;
        curMoveLoc = myLoc.add({{ move_dir }});
        {% for facing in related_map[dir_ord_map[move_dir]] %}
        face{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}();
        if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) return;
        {% endfor %}
    }

    {% for facing in related_map[dir_ord_map[move_dir]] %}
    private static void face{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (CombatTracker.threat{{ dir_short_map[move_dir] }}{{ dir_short_map[facing] }} != 0L) return;
        int moveCost = CombatCommon.movementCost({{ move_dir }}, {{ facing }});
        if (moveCost == -1) return;
        {% for place_dir in related_map[dir_ord_map[facing]] %}
        place{{ dir_short_map[place_dir] }}{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}();
        {% endfor %}
    }

    {% for place_dir in related_map[dir_ord_map[facing]] %}
    {%- set dx_total = dir_dx[move_dir] + dir_dx[place_dir] -%}
    {%- set dy_total = dir_dy[move_dir] + dir_dy[place_dir] -%}
    private static void place{{ dir_short_map[place_dir] }}{{ dir_short_map[facing] }}{{ dir_short_map[move_dir] }}() {
        if ({{ wvar(dx_total, dy_total) }} >= 0) {
            double score = {{ wvar(dx_total, dy_total) }};
            if ({{ facing }} != myDir) score *= 1.1;
            if (score > best) {
                best = score;
                bestPlaceLoc = curMoveLoc.add({{ place_dir }});
                bestMoveDir = {{ move_dir }};
                bestFacing = {{ facing }};
            }
        }
    }
    {% endfor %}
    {% endfor %}
    {% endfor %}

    
    public static boolean miniRun() throws GameActionException {
        if (!rc.isActionReady()) return false;
        if (rc.getAllCheese() < 300 || rc.getRawCheese() < 20 || !confirmCanPlace()) return false;
        if (weightCompTime != time) {
            clearWeights();
            weightSource = myLoc;
        }
        int x = myLocX;
        int y = myLocY;
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ ord }} -> {
                {% set cand = related_map[ord] %}
                {% for d in cand %}
                MapLocation loc{{ loop.index0 }} = new MapLocation(x {% if dir_dx[d] %} + {{ dir_dx[d] }}{% endif %}, y {% if dir_dy[d] %} + {{ dir_dy[d] }}{% endif %});
                double s{{ loop.index0 }} = getWeight(loc{{ loop.index0 }}.x - weightSource.x, loc{{ loop.index0 }}.y - weightSource.y);
                {% endfor %}
                for (int i = 0; i < RobotTracker.numEnemies && i < 2; i++) {
                    RobotInfo rinfo = RobotTracker.sortedEnemies[i];
                    if (rinfo.location.distanceSquaredTo(myLoc) > 2) break;
                    MapLocation eloc = rinfo.location;
                    {
                        if (eloc.distanceSquaredTo(loc0) <= 2) {
                            int ang = angleDistance(rinfo.direction, eloc.directionTo(loc0));
                            if (ang <= 3) s0 += 4 - ang;
                        }
                    }
                    {
                        if (eloc.distanceSquaredTo(loc1) <= 2) {
                            int ang = angleDistance(rinfo.direction, eloc.directionTo(loc1));
                            if (ang <= 3) s1 += 4 - ang;
                        }
                    }
                    {
                        if (eloc.distanceSquaredTo(loc2) <= 2) {
                            int ang = angleDistance(rinfo.direction, eloc.directionTo(loc2));
                            if (ang <= 3) s2 += 4 - ang;
                        }
                    }
                }
                double bestScore = -1;
                MapLocation bestLoc = null;
                if (rc.canPlaceRatTrap(loc0) && s0 > bestScore) {
                    bestScore = s0;
                    bestLoc = loc0;
                }
                if (rc.canPlaceRatTrap(loc1) && s1 > bestScore) {
                    bestScore = s1;
                    bestLoc = loc1;
                }
                if (rc.canPlaceRatTrap(loc2) && s2 > bestScore) {
                    bestScore = s2;
                    bestLoc = loc2;
                }
                if (bestScore <= 0) return false;
                rc.placeRatTrap(bestLoc);
                println("!!!!!!!!!! placed rat trap MINI");
                indicate("COMBAT STRAT: MINI TRAP");
                return true;
            }
            {% endfor %}    
            default -> { return false; }
        }
    }
}

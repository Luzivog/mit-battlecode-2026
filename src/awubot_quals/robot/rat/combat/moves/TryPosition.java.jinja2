public final class TryPosition {
    private TryPosition() {
    }

    static Direction bestMove;
    static Direction bestFacing;
    static double bestScore;
    static Direction moveDir;
    static MapLocation newLoc;
    static double score;
    static int bytecodeStart, bytecodeBudget;

    public static boolean run() throws GameActionException {
        if (!rc.isMovementReady()) return false;
        bytecodeStart = Clock.getBytecodeNum();
        bytecodeBudget = Math.min(3000, Clock.getBytecodesLeft() - 1000);
        // Profiler.push();
        bestMove = null;
        bestFacing = null;
        bestScore = -1e9;
        selectMoves();
        if (bestScore < 0) {
            println("POSITION IS COOKED UHJH OHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH");
        }
        assert(CombatStrategy.performMoves(bestMove, bestFacing));
        indicate("COMBAT STRAT: POSITION move " + bestMove + " face " + bestFacing + " score " + bestScore);
        return true;
    }

    private static void selectMoves() throws GameActionException {
        {% for move_dir in allDirections %}
        if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) return;
        move{{ dir_short_map[move_dir] }}();
        {% endfor %}
    }

    {% for move_dir in allDirections %}
    private static void move{{ dir_short_map[move_dir] }}() throws GameActionException {
        if (!CombatCommon.canMove{{dir_short_map[move_dir] }}) return;
        moveDir = {{ move_dir }};
        newLoc = myLoc.add({{ move_dir }});
        switch (myDir.ordinal()) {
            {% for ord in range(8) %}
            case {{ ord }} -> {
                {% for f in related_map[ord] %}
                face{{ dir_short_map[f] }}();
                if (Clock.getBytecodeNum() - bytecodeStart > bytecodeBudget) return;
                {% endfor %}
            }
            {% endfor %}
            default -> { }
        }
    }
    {% endfor %}

    {% for face_dir in directions %}
    private static void face{{ dir_short_map[face_dir] }}() throws GameActionException {
        int moveCost = CombatCommon.movementCost(moveDir, {{ face_dir }});
        if (moveCost == -1) return;
        score = 0;
        if (moveCost == 1) score += 10;
        if (moveDir != Direction.CENTER) score += 5;
        score += CombatStrategy.getCellScoreFor(moveDir, {{ face_dir }});
        if ({{ face_dir }} != myDir) {
            score += 2;
        }
        if (am(11908, 24)) {
            println("considered pos move " + moveDir + " face " + {{ face_dir }} + " score " + score);
        }
        if (score > bestScore) {
            bestScore = score;
            bestMove = moveDir;
            bestFacing = {{ face_dir }};
        }
    }
    {% endfor %}
}

    }
    {% endfor %}

    static void checkRot() {
        switch(mapHeight) {
            {% for height in range(20, 61) %}
            case {{height}} -> {
                checkRot{{height}}();
            }
            {% endfor %}
        }
    }
    static void applyRot() {
        switch(mapHeight) {
            {% for height in range(20, 61) %}
            case {{height}} -> {
                applyRot{{height}}();
            }
            {% endfor %}
        }
    }

    public static void checkSymmetry() {
        switch(getSymmetry().ordinal()) {
            case 0 -> {
                // Profiler.begin();
                // IF TLE: check one per turn instead of all 3
                if(hsym != 0) checkHor();
                if(vsym != 0) checkVer();
                if(rsym != 0) checkRot();
                // Profiler.end("checkSymmetry");
            }
            case 1 -> {
                // Profiler.begin();
                applyRot();
                // Profiler.end("applyRot");
            }
            case 2 -> {
                // Profiler.begin();
                applyHor();
                // Profiler.end("applyHor");
            }
            case 3 -> {
                // Profiler.begin();
                applyVer();
                // Profiler.end("applyVer");
            }
        }
    }
}

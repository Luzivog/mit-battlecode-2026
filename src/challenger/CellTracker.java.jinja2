                checkVer{{height}}();
            }
            {% endfor %}
        }
    }
    static void applyVer() {
        switch(mapHeight) {
            {% for height in range(20, 61) %}
            case {{height}} -> {
                applyVer{{height}}();
            }
            {% endfor %}
        }
    }

    {% for height in range(20, 61) %}

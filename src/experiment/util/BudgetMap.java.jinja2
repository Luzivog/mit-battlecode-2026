{# budgetmap_unrolled_trusted.j2 #}
package experiment.util;

/*

~150 bytecode for initialising rows, ~20 bytecode per read/write

*/

public final class BudgetMap {
    static int time = 1;

    {%- for i in range(60) %}
    static int[] r{{i}};
    {%- endfor %}

    private BudgetMap() {}

    public static void clear() { ++time; }

    public static int get(int r, int c) {
        switch (r) {
            {%- for i in range(60) %}
            case {{i}}: {
                int[] a = r{{i}};
                return (a != null && a[60 + c] == time) ? a[c] : 0;
            }
            {%- endfor %}
        }
        return 0; // unreachable (trusted input)
    }

    public static void set(int r, int c, int v) {
        switch (r) {
            {%- for i in range(60) %}
            case {{i}}: {
                int[] a = r{{i}};
                if (a == null) r{{i}} = a = new int[120];
                a[60 + c] = time;
                a[c] = v;
                return;
            }
            {%- endfor %}
        }
    }

    public static int add(int r, int c, int d) {
        switch (r) {
            {%- for i in range(60) %}
            case {{i}}: {
                int[] a = r{{i}};
                if (a == null) r{{i}} = a = new int[120];
                int sc = 60 + c;
                if (a[sc] != time) {
                    a[sc] = time;
                    return a[c] = d;
                }
                return a[c] += d;
            }
            {%- endfor %}
        }
        return 0; // unreachable (trusted input)
    }

    public static boolean has(int r, int c) {
        switch (r) {
            {%- for i in range(60) %}
            case {{i}}: {
                int[] a = r{{i}};
                return a != null && a[60 + c] == time;
            }
            {%- endfor %}
        }
        return false; // unreachable (trusted input)
    }

    public static void test() {
        Profiler.begin();
        set(0, 1, 2);
        Profiler.end(); 

        Profiler.begin();
        int x = get(0, 1);
        Profiler.end();

        Profiler.begin();
        set(0, 1, 3);
        Profiler.end();
    }
}
